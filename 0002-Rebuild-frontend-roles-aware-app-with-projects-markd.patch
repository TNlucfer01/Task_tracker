+                            segments={p.by_department.map((b) => ({ value: p.task_count ? (100 * b.done) / p.task_count : 0, color: departmentColor(depts, b.department_id), label: `${deptName(b.department_id)}: ${b.done} of ${b.total} done` }))}
+                          />
