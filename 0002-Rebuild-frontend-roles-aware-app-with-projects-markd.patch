+                    </ul>
+                  )}
+                </Panel>
+
+                <Panel title={`On the clock · ${s.on_the_clock.length}`}>
+                  {s.on_the_clock.length === 0 ? (
+                    <p className="text-ink-soft">Nobody is clocked in right now.</p>
+                  ) : (
+                    <ul className="divide-y divide-line">
