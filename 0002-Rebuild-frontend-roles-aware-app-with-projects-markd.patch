+              </div>
+            )}
+            {!clock.status?.session && task.can.track_time && (
+              <p className="mb-4 text-[13px] text-ink-faint">Clock in to time your work on this task.</p>
+            )}
+
+            <div className="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
+              <div className="grid min-w-0 gap-6">
+                {task.can.review && <ReviewBox task={task} onDone={(t) => (state.set({ ...task, ...t }), state.reload())} />}
+                <section className="rounded-lg border border-line bg-surface">
+                  <header className="flex flex-wrap items-center justify-between gap-2 border-b border-line px-4 py-2.5 sm:px-5">
+                    <h2 className="text-[13px] font-medium text-ink-soft">Description</h2>
+                    <div className="flex flex-wrap gap-1.5">
+                      {!editing && (
+                        <>
+                          <Button size="sm" variant="ghost" icon="download" onClick={() => run(async () => downloadText(`${task.key}.md`, await tasksApi.markdown(task.id)))}>
+                            .md
+                          </Button>
+                          <Button size="sm" variant="ghost" onClick={() => run(async () => (await navigator.clipboard.writeText(await tasksApi.markdown(task.id)), toast('Markdown copied')))}>
+                            Copy
+                          </Button>
+                          {task.can.edit && (
+                            <Button size="sm" icon="edit" onClick={startEdit}>
+                              Edit
+                            </Button>
+                          )}
+                        </>
+                      )}
+                    </div>
+                  </header>
+                  <div className="px-4 py-4 sm:px-5">
+                    {editing ? (
+                      <div className="grid gap-3">
+                        <MarkdownEditor label="Description" value={body} onChange={setBody} minRows={16} autoFocus />
+                        <div className="flex justify-end gap-2">
+                          <Button onClick={() => setEditing(false)}>Cancel</Button>
+                          <Button variant="primary" busy={busy} disabled={!title.trim()} onClick={saveDoc}>
+                            Save changes
+                          </Button>
+                        </div>
+                      </div>
+                    ) : task.body_md?.trim() ? (
+                      <Markdown text={task.body_md} />
+                    ) : (
+                      <p className="text-ink-faint">
+                        No description yet.{' '}
+                        {task.can.edit && (
+                          <button type="button" className="text-primary hover:underline" onClick={startEdit}>
+                            Write one
+                          </button>
+                        )}
+                      </p>
+                    )}
+                  </div>
+                </section>
+
+                <section>
+                  <Tabs
+                    value={tab}
+                    onChange={setTab}
+                    tabs={[
+                      { value: 'comments', label: `Comments${task.comments.length ? ` (${task.comments.length})` : ''}` },
+                      { value: 'reviews', label: `Reviews${task.reviews.length ? ` (${task.reviews.length})` : ''}` },
+                      { value: 'history', label: 'History' },
+                    ]}
+                  />
+                  {tab === 'comments' && <Comments task={task} onChange={state.reload} />}
+                  {tab === 'reviews' &&
+                    (task.reviews.length ? (
+                      <ul className="grid gap-3">
+                        {task.reviews.map((r) => (
+                          <li key={r.id} className="rounded-lg border border-line bg-surface px-4 py-3">
+                            <p className="flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px]">
+                              <span className={cx('font-medium', r.decision === 'approved' ? 'text-success' : 'text-warning')}>{r.decision === 'approved' ? 'Approved' : 'Changes requested'}</span>
+                              {r.rating && <Stars value={r.rating} />}
+                              <span className="text-ink-faint">
+                                {r.reviewer?.name ?? 'Former member'} · {formatDateTime(r.created_at)}
+                              </span>
+                            </p>
+                            {r.comment && <p className="mt-1.5 whitespace-pre-wrap">{r.comment}</p>}
+                          </li>
+                        ))}
+                      </ul>
+                    ) : (
+                      <p className="text-ink-soft">No reviews yet. Reviews appear after the task is submitted.</p>
+                    ))}
+                  {tab === 'history' && (
+                    <ol className="grid gap-2.5 border-l border-line pl-4">
+                      {task.events.map((e) => (
+                        <li key={e.id} className="relative text-sm">
+                          <span className="absolute top-1.5 -left-[21px] size-2.5 rounded-full border-2 border-surface bg-line-strong" aria-hidden />
+                          <span className="font-medium">{e.actor?.name ?? 'System'}</span> {describeEvent(e)}
+                          <span className="block text-[12px] text-ink-faint">{formatDateTime(e.created_at)}</span>
+                        </li>
+                      ))}
+                    </ol>
+                  )}
+                </section>
+              </div>
+
+              <aside className="grid gap-4 lg:sticky lg:top-6">
+                <PropertiesPanel task={task} onSaved={(t) => state.set({ ...task, ...t })} />
+                <p className="px-1 text-[12px] text-ink-faint">
+                  Created {formatDateTime(task.created_at)} · updated {relative(task.updated_at)}
+                  {task.completed_at ? ` · done ${formatDate(task.completed_at)}` : ''}
+                </p>
+                {task.can.delete && (
+                  <div className="px-1">
+                    <ConfirmButton
+                      size="sm"
+                      icon="trash"
+                      label="Delete task"
+                      title={`Delete ${task.key}?`}
+                      confirm="This removes the task with its comments, reviews and timers. It can't be undone."
+                      onConfirm={async () => {
+                        await tasksApi.remove(task.id)
+                        toast(`${task.key} deleted`)
+                        go('projects', task.project.id)
+                      }}
+                    />
+                  </div>
+                )}
+              </aside>
+            </div>
+          </>
+        )
+      }}
+    </DataState>
+  )
+}
diff --git a/Front/src/pages/Tasks.tsx b/Front/src/pages/Tasks.tsx
new file mode 100644
index 0000000..ac94d3c
--- /dev/null
+++ b/Front/src/pages/Tasks.tsx
@@ -0,0 +1,204 @@
+// Tasks: every task you can see, as a table or a board, with filters kept in the URL.
+import { useState } from 'react'
+import { departments as departmentsApi, projects as projectsApi, tasks as tasksApi, users as usersApi } from '../api/endpoints'
+import { ImportDialog, NewTaskDialog, TaskBoard, TaskTable } from '../components/tasks'
+import { Button, Checkbox, DataState, Field, Input, PageHeader, Segmented, Select, Toolbar } from '../components/ui'
+import { plural, priorities, priorityLabel, taskStatusLabel, taskStatuses } from '../lib/format'
+import { setParams } from '../lib/router'
+import { can, useMe } from '../lib/session'
+import { useApi } from '../lib/useApi'
+
+const FILTER_KEYS = ['q', 'status', 'assignee', 'project_id', 'priority', 'department_id', 'overdue', 'label'] as const
+
+/** Reads the filters from the URL. */
+function filtersFrom(params: URLSearchParams) {
+  return Object.fromEntries(FILTER_KEYS.map((k) => [k, params.get(k) ?? ''])) as Record<(typeof FILTER_KEYS)[number], string>
+}
+
+/** The Tasks page; `fixed` pins filters (used inside a project page). */
+export function Tasks({ params, fixed, embedded }: { params: URLSearchParams; fixed?: { project_id: number }; embedded?: boolean }) {
+  const me = useMe()
+  const filters = { ...filtersFrom(params), ...(fixed ? { project_id: String(fixed.project_id) } : {}) }
+  const view = params.get('view') === 'board' ? 'board' : 'list'
+  const [creating, setCreating] = useState(false)
+  const [importing, setImporting] = useState(false)
+  const [search, setSearch] = useState(filters.q)
+  const key = JSON.stringify(filters) + view
+  const tasks = useApi(() => tasksApi.list({ ...filters, sort: view === 'board' ? 'board' : 'deadline', limit: 500 }), key)
+  const projects = useApi(() => (fixed ? Promise.resolve({ projects: [] }) : projectsApi.list()), 'tasks-projects')
+  const people = useApi(() => (me.role.scope === 'own' ? Promise.resolve({ users: [] }) : usersApi.options()), 'tasks-people')
+  const depts = useApi(() => (me.role.scope === 'all' ? departmentsApi.list() : Promise.resolve({ departments: [] })), 'tasks-depts')
+
+  /** Updates one filter in the URL. */
+  const update = (patch: Partial<typeof filters> & { view?: string }) => {
+    const next: Record<string, string | undefined> = { ...filtersFrom(params), view: view === 'board' ? 'board' : undefined, ...patch }
+    setParams(next)
+  }
+  const hasFilters = FILTER_KEYS.some((k) => k !== 'project_id' && filters[k]) || (!fixed && filters.project_id)
+
+  const header = embedded ? null : (
+    <PageHeader
+      title="Tasks"
+      lede={me.role.scope === 'own' ? 'Work assigned to you or created by you.' : me.role.scope === 'department' ? `Work in ${me.department_name ?? 'your department'}.` : 'Work across the company.'}
+      actions={
+        can(me, 'tasks.create') && (
+          <>
+            <Button icon="upload" onClick={() => setImporting(true)}>
+              Import .md
+            </Button>
+            <Button variant="primary" icon="plus" onClick={() => setCreating(true)}>
+              New task
+            </Button>
+          </>
+        )
+      }
+    />
+  )
+
+  return (
+    <>
+      {header}
+      <Toolbar>
+        <form
+          onSubmit={(e) => {
+            e.preventDefault()
+            update({ q: search })
+          }}
+        >
+          <Field label="Search">{(id) => <Input id={id} type="search" placeholder="Title or key" value={search} onChange={(e) => setSearch(e.target.value)} onBlur={() => search !== filters.q && update({ q: search })} className="w-52" />}</Field>
+        </form>
+        <Field label="Status">
+          {(id) => (
+            <Select id={id} value={filters.status} onChange={(e) => update({ status: e.target.value })} className="w-36">
+              <option value="">Any</option>
+              <option value="todo,in_progress,in_review,rework">Not done</option>
+              {taskStatuses.map((s) => (
+                <option key={s} value={s}>
+                  {taskStatusLabel[s]}
+                </option>
+              ))}
+            </Select>
+          )}
+        </Field>
+        {me.role.scope !== 'own' && (
+          <Field label="Assignee">
+            {(id) => (
+              <Select id={id} value={filters.assignee} onChange={(e) => update({ assignee: e.target.value })} className="w-40">
+                <option value="">Anyone</option>
+                <option value="me">Me</option>
+                <option value="none">Unassigned</option>
+                {people.data?.users.map((u) => (
+                  <option key={u.id} value={u.id}>
+                    {u.name}
+                  </option>
+                ))}
+              </Select>
+            )}
+          </Field>
+        )}
+        {!fixed && (
+          <Field label="Project">
+            {(id) => (
+              <Select id={id} value={filters.project_id} onChange={(e) => update({ project_id: e.target.value })} className="w-44">
+                <option value="">Any</option>
+                {projects.data?.projects.map((p) => (
+                  <option key={p.id} value={p.id}>
+                    {p.key} · {p.name}
+                  </option>
+                ))}
+              </Select>
+            )}
+          </Field>
+        )}
+        <Field label="Priority">
+          {(id) => (
+            <Select id={id} value={filters.priority} onChange={(e) => update({ priority: e.target.value })} className="w-32">
+              <option value="">Any</option>
+              {priorities.map((p) => (
+                <option key={p} value={p}>
+                  {priorityLabel[p]}
+                </option>
+              ))}
+            </Select>
+          )}
+        </Field>
+        {me.role.scope === 'all' && !fixed && (
+          <Field label="Department">
+            {(id) => (
+              <Select id={id} value={filters.department_id} onChange={(e) => update({ department_id: e.target.value })} className="w-40">
+                <option value="">Any</option>
+                {depts.data?.departments.map((d) => (
+                  <option key={d.id} value={d.id}>
+                    {d.name}
+                  </option>
+                ))}
+              </Select>
+            )}
+          </Field>
+        )}
+        <div className="pb-2">
+          <Checkbox label="Overdue only" checked={filters.overdue === 'true'} onChange={(v) => update({ overdue: v ? 'true' : '' })} />
+        </div>
+        {hasFilters && (
+          <Button
+            variant="ghost"
+            onClick={() => {
+              setSearch('')
+              setParams({ view: view === 'board' ? 'board' : undefined })
+            }}
+          >
+            Clear filters
+          </Button>
+        )}
+        <div className="ml-auto pb-0.5">
+          <Segmented
+            label="View"
+            value={view}
+            onChange={(v) => update({ view: v === 'board' ? 'board' : undefined })}
+            options={[
+              { value: 'list', label: 'List' },
+              { value: 'board', label: 'Board' },
+            ]}
+          />
+        </div>
+      </Toolbar>
+
+      <DataState state={tasks} isEmpty={(d) => d.tasks.length === 0 && view === 'list'} empty={hasFilters ? 'No tasks match these filters.' : 'No tasks yet. Create one to get started.'}>
+        {(d) => (
+          <>
+            <p className="mb-2 text-[13px] text-ink-soft">{plural(d.tasks.length, 'task')}</p>
+            {view === 'board' ? (
+              <TaskBoard tasks={d.tasks} onChanged={tasks.reload} />
+            ) : (
+              <div className="rounded-lg border border-line bg-surface">
+                <TaskTable tasks={d.tasks} showProject={!fixed} />
+              </div>
+            )}
+          </>
+        )}
+      </DataState>
+      <NewTaskDialog open={creating} onClose={() => setCreating(false)} projectId={fixed?.project_id} />
+      <ImportDialog open={importing} onClose={() => setImporting(false)} projectId={fixed?.project_id} />
+    </>
+  )
+}
+
+/** Opens the new-task and import dialogs from outside (project page header). */
+export function TaskActions({ projectId }: { projectId: number }) {
+  const me = useMe()
+  const [creating, setCreating] = useState(false)
+  const [importing, setImporting] = useState(false)
+  if (!can(me, 'tasks.create')) return null
+  return (
+    <>
+      <Button icon="upload" onClick={() => setImporting(true)}>
+        Import .md
+      </Button>
+      <Button variant="primary" icon="plus" onClick={() => setCreating(true)}>
+        New task
+      </Button>
+      <NewTaskDialog open={creating} onClose={() => setCreating(false)} projectId={projectId} />
+      <ImportDialog open={importing} onClose={() => setImporting(false)} projectId={projectId} />
+    </>
+  )
+}
