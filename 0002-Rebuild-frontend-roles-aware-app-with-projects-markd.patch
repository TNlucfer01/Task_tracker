+.prose-md input[type="checkbox"] { margin-right: 6px; accent-color: var(--primary); }
+.prose-md code { background: var(--subtle); border-radius: 4px; padding: 1px 5px; font-size: 0.92em; }
+.prose-md pre { background: var(--subtle); border: 1px solid var(--line); border-radius: 6px; padding: 12px; overflow-x: auto; }
+.prose-md pre code { background: none; padding: 0; }
+.prose-md blockquote { border-left: 3px solid var(--line-strong); padding-left: 12px; color: var(--ink-soft); }
+.prose-md table { border-collapse: collapse; display: block; overflow-x: auto; }
+.prose-md th, .prose-md td { border: 1px solid var(--line); padding: 6px 10px; }
