+.prose-md h2 { font-size: 18px; line-height: 24px; font-weight: 600; margin: 20px 0 8px; }
+.prose-md h3 { font-size: 15px; font-weight: 600; margin: 16px 0 6px; }
+.prose-md p, .prose-md ul, .prose-md ol, .prose-md pre, .prose-md blockquote, .prose-md table { margin: 0 0 12px; }
+.prose-md ul { list-style: disc; padding-left: 22px; }
+.prose-md ol { list-style: decimal; padding-left: 22px; }
+.prose-md li { margin: 2px 0; }
