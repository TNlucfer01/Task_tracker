+++ b/Back/src/modules/reviews/routes.js
@@ -0,0 +1,40 @@
+// Reviewing submitted work: approve with a 1–5 rating (task becomes Done) or request changes (Rework).
+const express = require("express");
+const sql = require("../../db");
+const v = require("../../lib/validate");
+const { HttpError, forbid } = require("../../lib/http");
+const { notify } = require("../notifications/service");
+const { visibleTask, canReview } = require("../tasks/service");
+
+const router = express.Router();
+
+/** POST /tasks/:id/reviews — records a review decision and moves the task on. */
+router.post("/tasks/:id/reviews", async (req, res) => {
+  const me = res.locals.me;
+  const task = await visibleTask(me, v.id(req.params.id, "task id"));
+  if (!canReview(me, task)) forbid(task.assignee_id === me.id ? "You can't review your own work." : "You can't review work.");
+  if (task.status !== "in_review") throw new HttpError(400, "This task isn't waiting for review.");
+  const b = req.body ?? {};
+  const decision = v.oneOf(b.decision, ["approved", "changes_requested"], "Decision");
+  const rating = decision === "approved" ? v.int(b.rating, "Rating", { min: 1, max: 5 }) : null;
+  const comment = v.optionalText(b.comment, "Comment", { max: 2000 }) ?? "";
+  if (decision === "changes_requested" && !comment) throw new HttpError(400, "Say what needs to change.");
+
+  await sql.begin(async (tx) => {
+    await tx`insert into task_reviews (task_id, reviewer_id, assignee_id, decision, rating, comment)
+             values (${task.id}, ${me.id}, ${task.assignee_id}, ${decision}, ${rating}, ${comment})`;
+    await tx`update tasks set status = ${decision === "approved" ? "done" : "rework"}, updated_by = ${me.id} where id = ${task.id}`;
+    await tx`insert into task_events (task_id, actor_id, type, data) values (${task.id}, ${me.id}, 'review', ${tx.json({ decision, rating })})`;
+    await notify(tx, {
+      userIds: [task.assignee_id],
+      type: decision,
+      title: decision === "approved" ? `${task.key} was approved` : `${task.key} needs changes`,
+      body: comment || task.title,
+      taskId: task.id,
+      actorId: me.id,
+    });
+  });
+  res.status(201).json({ task: await visibleTask(me, task.id) });
+});
+
+module.exports = router;
diff --git a/Back/src/modules/roles/routes.js b/Back/src/modules/roles/routes.js
new file mode 100644
index 0000000..60b7107
--- /dev/null
+++ b/Back/src/modules/roles/routes.js
@@ -0,0 +1,90 @@
+// Roles and the permission catalogue. A role bundles permissions with a data scope.
+const express = require("express");
+const sql = require("../../db");
+const v = require("../../lib/validate");
+const { HttpError, found } = require("../../lib/http");
+const { permit, permitAny } = require("../../middleware/auth");
+
+const router = express.Router();
+const SCOPES = ["all", "department", "own"];
+
+/** Loads every role with its permissions and member count. */
+async function listRoles() {
+  return sql`
+    select r.id, r.name, r.description, r.scope, r.is_system,
+           coalesce(array_agg(distinct rp.permission) filter (where rp.permission is not null), '{}') as permissions,
+           (select count(*) from users u where u.role_id = r.id) as members
+    from roles r left join role_permissions rp on rp.role_id = r.id
+    group by r.id order by r.is_system desc, lower(r.name)`;
+}
+
+/** Validates a permission list against the catalogue. */
+async function validPermissions(list) {
+  if (!Array.isArray(list)) throw new HttpError(400, "Permissions must be a list.");
+  const known = new Set((await sql`select key from permissions`).map((p) => p.key));
+  const unknown = list.filter((p) => !known.has(p));
+  if (unknown.length) throw new HttpError(400, `Unknown permissions: ${unknown.join(", ")}.`);
+  return [...new Set(list)];
+}
+
+/** GET /roles/permissions — the catalogue, grouped for the role editor. */
+router.get("/permissions", permitAny("roles.manage", "people.manage"), async (req, res) => {
+  res.json({ permissions: await sql`select key, label, grp as "group", description from permissions order by position` });
+});
+
+/** GET /roles — all roles, for the role editor and the person form. */
+router.get("/", permitAny("roles.manage", "people.manage"), async (req, res) => {
+  res.json({ roles: await listRoles() });
+});
+
+/** POST /roles — creates a role. */
+router.post("/", permit("roles.manage"), async (req, res) => {
+  const b = req.body ?? {};
+  const name = v.text(b.name, "Role name", { min: 2, max: 40 });
+  const description = v.optionalText(b.description, "Description", { max: 200 }) ?? "";
+  const scope = v.oneOf(b.scope ?? "own", SCOPES, "Scope");
+  const permissions = await validPermissions(b.permissions ?? []);
+  const id = await sql.begin(async (tx) => {
+    const [role] = await tx`insert into roles (name, description, scope) values (${name}, ${description}, ${scope}) returning id`;
+    if (permissions.length) await tx`insert into role_permissions ${tx(permissions.map((p) => ({ role_id: role.id, permission: p })))}`;
+    return role.id;
+  });
+  res.status(201).json({ role: (await listRoles()).find((r) => r.id === id) });
+});
+
+/** PATCH /roles/:id — renames a role, changes its scope, or replaces its permissions. */
+router.patch("/:id", permit("roles.manage"), async (req, res) => {
+  const roleId = v.id(req.params.id, "role id");
+  const [role] = await sql`select * from roles where id = ${roleId}`;
+  found(role, "That role");
+  const b = req.body ?? {};
+  if (role.is_system && (b.scope !== undefined || b.permissions !== undefined)) {
+    throw new HttpError(400, "The Admin role always has every permission across the whole company.");
+  }
+  const changes = {};
+  if (b.name !== undefined) changes.name = v.text(b.name, "Role name", { min: 2, max: 40 });
+  if (b.description !== undefined) changes.description = v.optionalText(b.description, "Description", { max: 200 });
+  if (b.scope !== undefined) changes.scope = v.oneOf(b.scope, SCOPES, "Scope");
+  const permissions = b.permissions === undefined ? undefined : await validPermissions(b.permissions);
+  await sql.begin(async (tx) => {
+    if (Object.keys(changes).length) await tx`update roles set ${tx(changes)} where id = ${roleId}`;
+    if (permissions) {
+      await tx`delete from role_permissions where role_id = ${roleId}`;
+      if (permissions.length) await tx`insert into role_permissions ${tx(permissions.map((p) => ({ role_id: roleId, permission: p })))}`;
+    }
+  });
+  res.json({ role: (await listRoles()).find((r) => r.id === roleId) });
+});
+
+/** DELETE /roles/:id — deletes an unused, non-system role. */
+router.delete("/:id", permit("roles.manage"), async (req, res) => {
+  const roleId = v.id(req.params.id, "role id");
+  const [role] = await sql`select is_system, (select count(*) from users where role_id = ${roleId}) as members from roles where id = ${roleId}`;
+  found(role, "That role");
+  if (role.is_system) throw new HttpError(400, "The Admin role can't be deleted.");
+  if (role.members > 0) throw new HttpError(409, `${role.members} people have this role. Give them another role first.`);
+  await sql`delete from roles where id = ${roleId}`;
+  res.status(204).end();
+});
+
+module.exports = router;
diff --git a/Back/src/modules/tasks/routes.js b/Back/src/modules/tasks/routes.js
new file mode 100644
index 0000000..c532142
--- /dev/null
+++ b/Back/src/modules/tasks/routes.js
@@ -0,0 +1,249 @@
+// Tasks: list and board, the task page (Markdown body + properties), create, edit, delete,
+// submit for review, and .md import/export.
+const express = require("express");
+const sql = require("../../db");
+const v = require("../../lib/validate");
+const { HttpError, found, forbid } = require("../../lib/http");
+const { can } = require("../../middleware/auth");
+const { taskFilter, projectFilter, canSeeUser } = require("../../access");
+const { taskToMarkdown, parseMarkdown } = require("../../lib/markdown");
+const { notify, reviewersFor } = require("../notifications/service");
+const { fieldsFor } = require("../projects/routes");
+const { listColumns, listFrom, visibleTask, canEdit, canReview, validateProperties } = require("./service");
+
+const router = express.Router();
+const STATUSES = ["todo", "in_progress", "in_review", "rework", "done"];
+const PRIORITIES = ["low", "medium", "high", "urgent"];
+// Statuses you can set directly. In review goes through /submit; Done and Rework only through a review.
+const SETTABLE = ["todo", "in_progress"];
+const SORTS = {
+  updated: sql`t.updated_at desc`,
+  deadline: sql`t.deadline asc nulls last, t.id`,
+  priority: sql`case t.priority when 'urgent' then 0 when 'high' then 1 when 'medium' then 2 else 3 end, t.deadline asc nulls last`,
+  created: sql`t.created_at desc`,
+  board: sql`t.position asc, t.id`,
+};
+
+/** GET /tasks — tasks you can see, with filters for the list and the board. */
+router.get("/", async (req, res) => {
+  const me = res.locals.me;
+  const q = req.query;
+  const project = q.project_id ? v.id(q.project_id, "project_id") : null;
+  const statuses = q.status ? String(q.status).split(",").map((s) => v.oneOf(s, STATUSES, "status")) : null;
+  const assignee = q.assignee === "me" ? me.id : q.assignee === "none" ? "none" : q.assignee ? v.id(q.assignee, "assignee") : null;
+  const priority = q.priority ? v.oneOf(q.priority, PRIORITIES, "priority") : null;
+  const label = typeof q.label === "string" && q.label ? q.label.toLowerCase() : null;
+  const search = typeof q.q === "string" && q.q.trim() ? `%${q.q.trim().toLowerCase()}%` : null;
+  const department = q.department_id ? v.id(q.department_id, "department_id") : null;
+  const sort = SORTS[q.sort] ?? SORTS.updated;
+  const limit = q.limit ? v.int(q.limit, "limit", { min: 1, max: 500 }) : 300;
+
+  const rows = await sql`
+    select ${listColumns} ${listFrom}
+    where ${taskFilter(me)}
+      ${project ? sql`and t.project_id = ${project}` : sql``}
+      ${statuses ? sql`and t.status = any(${statuses}::task_status[])` : sql``}
+      ${assignee === "none" ? sql`and t.assignee_id is null` : assignee ? sql`and t.assignee_id = ${assignee}` : sql``}
+      ${priority ? sql`and t.priority = ${priority}` : sql``}
+      ${label ? sql`and ${label} = any(t.labels)` : sql``}
+      ${search ? sql`and (lower(t.title) like ${search} or lower(p.key || '-' || t.number) like ${search})` : sql``}
+      ${department ? sql`and a.department_id = ${department}` : sql``}
+      ${q.overdue === "true" ? sql`and t.status <> 'done' and t.deadline < now()` : sql``}
+      ${q.due_within ? sql`and t.status <> 'done' and t.deadline between now() and now() + ${v.int(q.due_within, "due_within", { min: 1, max: 90 }) + " days"}::interval` : sql``}
+    order by ${sort} limit ${limit}`;
+  res.json({ tasks: rows });
+});
+
+/** GET /tasks/:id — the full task page: body, properties, fields, reviews, history and what you can do. */
+router.get("/:id", async (req, res) => {
+  const me = res.locals.me;
+  const task = await visibleTask(me, v.id(req.params.id, "task id"));
+  const [fields, reviews, events, comments, timer] = await Promise.all([
+    fieldsFor(task.project_id),
+    sql`select rv.id, rv.decision, rv.rating, rv.comment, rv.created_at,
+               case when u.id is null then null else json_build_object('id', u.id, 'name', u.name) end as reviewer
+        from task_reviews rv left join users u on u.id = rv.reviewer_id where rv.task_id = ${task.id} order by rv.created_at desc`,
+    sql`select e.id, e.type, e.data, e.created_at,
+               case when u.id is null then null else json_build_object('id', u.id, 'name', u.name) end as actor
+        from task_events e left join users u on u.id = e.actor_id where e.task_id = ${task.id} order by e.created_at desc limit 100`,
+    sql`select c.id, c.body_md, c.created_at, c.edited_at, c.author_id,
+               case when u.id is null then null else json_build_object('id', u.id, 'name', u.name) end as author
+        from task_comments c left join users u on u.id = c.author_id where c.task_id = ${task.id} order by c.created_at`,
+    sql`select id, started_at from task_time_logs where task_id = ${task.id} and user_id = ${me.id} and ended_at is null`,
+  ]);
+  res.json({
+    task: {
+      ...task,
+      fields,
+      reviews,
+      events,
+      comments,
+      my_running_timer: timer[0] ?? null,
+      can: {
+        edit: canEdit(me, task),
+        assign: can(me, "tasks.assign"),
+        delete: can(me, "tasks.delete"),
+        review: canReview(me, task) && task.status === "in_review",
+        submit: task.assignee_id === me.id && ["todo", "in_progress", "rework"].includes(task.status),
+        comment: true,
+        track_time: can(me, "time.track") && task.assignee_id === me.id && task.status !== "done",
+      },
+    },
+  });
+});
+
+/** Checks the person can be assigned by `me`: yourself always; others need tasks.assign and visibility. */
+async function validAssignee(me, value) {
+  const id = v.nullableId(value, "Assignee");
+  if (id === null || id === me.id) return id;
+  if (!can(me, "tasks.assign")) forbid("You can only assign tasks to yourself.");
+  const [u] = await sql`select is_active from users where id = ${id}`;
+  if (!u?.is_active || !(await canSeeUser(me, id))) throw new HttpError(400, "You can't assign work to that person.");
+  return id;
+}
+
+/** Validates the editable task fields present in a request body. */
+async function parseTask(b, me, fields, { creating }) {
+  const out = {};
+  if (creating || b.title !== undefined) out.title = v.text(b.title, "Title", { max: 200 });
+  if (b.body_md !== undefined) out.body_md = v.optionalText(b.body_md, "Description", { max: 100000 });
+  if (b.priority !== undefined) out.priority = v.oneOf(b.priority, PRIORITIES, "Priority");
+  if (b.deadline !== undefined) out.deadline = v.timestamp(b.deadline, "Deadline");
+  if (b.start_date !== undefined) out.start_date = v.day(b.start_date, "Start date");
+  if (b.estimate_minutes !== undefined) out.estimate_minutes = b.estimate_minutes === null ? null : v.int(b.estimate_minutes, "Estimate", { min: 1, max: 100000 });
+  if (b.labels !== undefined) out.labels = v.labels(b.labels);
+  if (b.properties !== undefined) out.properties = validateProperties(b.properties, fields);
+  if (b.assignee_id !== undefined) out.assignee_id = await validAssignee(me, b.assignee_id);
+  if (b.position !== undefined) {
+    const n = Number(b.position);
+    if (!Number.isFinite(n)) throw new HttpError(400, "Position must be a number.");
+    out.position = n;
+  }
+  return out;
+}
+
+/** Loads a project for creating tasks in, checking it is visible. */
+async function projectForNewTask(me, projectId) {
+  const [project] = await sql`select p.id, p.key, p.status from projects p where p.id = ${projectId} and ${projectFilter(me)}`;
+  found(project, "That project");
+  if (project.status === "completed") throw new HttpError(400, "This project is completed. Reopen it to add tasks.");
+  return project;
+}
+
+/** Inserts a task inside a transaction, notifying the assignee. Returns the new id. */
+async function createTask(tx, me, project, row) {
+  const [task] = await tx`insert into tasks ${tx({ ...row, project_id: project.id, reporter_id: me.id, updated_by: me.id })} returning id, number, assignee_id`;
+  if (task.assignee_id) {
+    await notify(tx, { userIds: [task.assignee_id], type: "assigned", title: `You were assigned ${project.key}-${task.number}`, body: row.title, taskId: task.id, actorId: me.id });
+  }
+  return task.id;
+}
+
+/** POST /tasks — creates a task (you're the assignee unless you can assign others). */
+router.post("/", async (req, res) => {
+  const me = res.locals.me;
+  if (!can(me, "tasks.create")) forbid("You can't create tasks.");
+  const b = req.body ?? {};
+  const project = await projectForNewTask(me, v.id(b.project_id, "Project"));
+  const fields = await fieldsFor(project.id);
+  const row = await parseTask({ assignee_id: me.id, ...b }, me, fields, { creating: true });
+  if (b.status !== undefined) row.status = v.oneOf(b.status, SETTABLE, "Status");
+  const id = await sql.begin((tx) => createTask(tx, me, project, row));
+  res.status(201).json({ task: await visibleTask(me, id) });
+});
+
+/** PATCH /tasks/:id — edits a task. Status can only move between Not started and In progress here. */
+router.patch("/:id", async (req, res) => {
+  const me = res.locals.me;
+  const task = await visibleTask(me, v.id(req.params.id, "task id"));
+  const b = req.body ?? {};
+  const onlyBoardMove = Object.keys(b).every((k) => ["status", "position"].includes(k));
+  if (!canEdit(me, task) && !(onlyBoardMove && task.assignee_id === me.id)) forbid("You can't edit this task.");
+  const fields = await fieldsFor(task.project_id);
+  const changes = await parseTask(b, me, fields, { creating: false });
+  if (b.status !== undefined && b.status !== task.status) {
+    if (b.status === "in_review") throw new HttpError(400, "Use Submit for review, so a reviewer is notified.");
+    if (b.status === "done" || b.status === "rework") throw new HttpError(400, "Only a reviewer can mark work done or send it back.");
+    if (task.status === "done") throw new HttpError(400, "Finished work can't be reopened here. Ask a reviewer.");
+    changes.status = v.oneOf(b.status, SETTABLE, "Status");
+  }
+  if (!Object.keys(changes).length) throw new HttpError(400, "Nothing to change.");
+
+  await sql.begin(async (tx) => {
+    await tx`update tasks set ${tx({ ...changes, updated_by: me.id })} where id = ${task.id}`;
+    const edited = Object.keys(changes).filter((k) => !["status", "assignee_id", "position"].includes(k));
+    if (edited.length) await tx`insert into task_events (task_id, actor_id, type, data) values (${task.id}, ${me.id}, 'updated', ${tx.json({ fields: edited })})`;
+    if (changes.assignee_id && changes.assignee_id !== task.assignee_id) {
+      await notify(tx, { userIds: [changes.assignee_id], type: "assigned", title: `You were assigned ${task.key}`, body: changes.title ?? task.title, taskId: task.id, actorId: me.id });
+    }
+  });
+  res.json({ task: await visibleTask(me, task.id) });
+});
+
+/** DELETE /tasks/:id — deletes a task and everything attached to it. */
+router.delete("/:id", async (req, res) => {
+  const me = res.locals.me;
+  if (!can(me, "tasks.delete")) forbid("You can't delete tasks.");
+  const task = await visibleTask(me, v.id(req.params.id, "task id"));
+  await sql`delete from tasks where id = ${task.id}`;
+  res.status(204).end();
+});
+
+/** POST /tasks/:id/submit — the assignee hands work in for review; reviewers are notified. */
+router.post("/:id/submit", async (req, res) => {
+  const me = res.locals.me;
+  const task = await visibleTask(me, v.id(req.params.id, "task id"));
+  if (task.assignee_id !== me.id) forbid("Only the person assigned can submit this for review.");
+  if (!["todo", "in_progress", "rework"].includes(task.status)) throw new HttpError(400, "This task can't be submitted right now.");
+  validateProperties(task.properties, await fieldsFor(task.project_id), { requireAll: true });
+  await sql.begin(async (tx) => {
+    await tx`update tasks set status = 'in_review', updated_by = ${me.id} where id = ${task.id}`;
+    await tx`update task_time_logs set ended_at = now() where user_id = ${me.id} and task_id = ${task.id} and ended_at is null`;
+    await notify(tx, { userIds: await reviewersFor(tx, task), type: "review_requested", title: `${task.key} is ready for review`, body: task.title, taskId: task.id, actorId: me.id });
+  });
+  res.json({ task: await visibleTask(me, task.id) });
+});
+
+/** GET /tasks/:id/markdown — downloads the task as a .md file with its properties. */
+router.get("/:id/markdown", async (req, res) => {
+  const task = await visibleTask(res.locals.me, v.id(req.params.id, "task id"));
+  res.setHeader("Content-Type", "text/markdown; charset=utf-8");
+  res.setHeader("Content-Disposition", `attachment; filename="${task.key}.md"`);
+  res.send(taskToMarkdown(task));
+});
+
+/** POST /tasks/import — creates a task from a .md file ({ project_id, markdown }). */
+router.post("/import", async (req, res) => {
+  const me = res.locals.me;
+  if (!can(me, "tasks.create")) forbid("You can't create tasks.");
+  const project = await projectForNewTask(me, v.id(req.body?.project_id, "Project"));
+  const { front, body } = parseMarkdown(req.body?.markdown);
+  let assignee = me.id;
+  if (typeof front.assignee === "string" && front.assignee.trim()) {
+    const [u] = await sql`select id from users where lower(name) = ${front.assignee.trim().toLowerCase()} and is_active`;
+    if (!u) throw new HttpError(400, `Nobody called "${front.assignee}" was found.`);
+    assignee = u.id;
+  }
+  const fields = await fieldsFor(project.id);
+  const row = await parseTask(
+    {
+      title: front.title,
+      body_md: body,
+      priority: front.priority ?? undefined,
+      deadline: front.deadline ? new Date(front.deadline).toISOString() : undefined,
+      start_date: front.start_date ? String(front.start_date).slice(0, 10) : undefined,
+      estimate_minutes: front.estimate_minutes ?? undefined,
+      labels: Array.isArray(front.labels) ? front.labels.map(String) : undefined,
+      properties: front.properties ?? undefined,
+      assignee_id: assignee,
+    },
+    me,
+    fields,
+    { creating: true },
+  );
+  if (front.status && SETTABLE.includes(front.status)) row.status = front.status;
+  const id = await sql.begin((tx) => createTask(tx, me, project, row));
+  res.status(201).json({ task: await visibleTask(me, id) });
+});
+
+module.exports = router;
diff --git a/Back/src/modules/tasks/service.js b/Back/src/modules/tasks/service.js
new file mode 100644
index 0000000..43ac46f
--- /dev/null
+++ b/Back/src/modules/tasks/service.js
@@ -0,0 +1,95 @@
+// Task rules shared by the task, comment and review modules: loading with visibility, who may
+// edit, and validating custom-field values against the project's field definitions.
+const sql = require("../../db");
+const { HttpError, found } = require("../../lib/http");
+const { can } = require("../../middleware/auth");
+const { taskFilter } = require("../../access");
+
+/** Columns for a task list row (no body). */
+const listColumns = sql`
+  t.id, t.number, p.key || '-' || t.number as key, t.title, t.status, t.priority, t.deadline, t.start_date,
+  t.estimate_minutes, t.labels, t.properties, t.position, t.created_at, t.updated_at, t.completed_at,
+  t.project_id, t.assignee_id, t.reporter_id,
+  json_build_object('id', p.id, 'key', p.key, 'name', p.name) as project,
+  case when a.id is null then null else json_build_object('id', a.id, 'name', a.name) end as assignee,
+  (t.status <> 'done' and t.deadline < now()) as overdue,
+  coalesce((select actual_minutes from v_task_time vt where vt.task_id = t.id), 0) as actual_minutes,
+  (select count(*) from task_comments c where c.task_id = t.id) as comment_count`;
+
+/** The FROM clause matching listColumns. */
+const listFrom = sql`from tasks t join projects p on p.id = t.project_id left join users a on a.id = t.assignee_id`;
+
+/** Loads a task `me` can see (with body), or throws 404. */
+async function visibleTask(me, id, tx = sql) {
+  const [task] = await tx`
+    select ${listColumns}, t.body_md,
+           case when r.id is null then null else json_build_object('id', r.id, 'name', r.name) end as reporter,
+           p.department_id as project_department_id, p.owner_id as project_owner_id
+    ${listFrom} left join users r on r.id = t.reporter_id
+    where t.id = ${id} and ${taskFilter(me)}`;
+  return found(task, "That task");
+}
+
+/** True when `me` may edit this task's content. */
+function canEdit(me, task) {
+  return task.assignee_id === me.id || task.reporter_id === me.id || can(me, "tasks.edit_any");
+}
+
+/** True when `me` may review this task (never your own work, unless you're an admin). */
+function canReview(me, task) {
+  return can(me, "reviews.perform") && (task.assignee_id !== me.id || me.role.is_system);
+}
+
+/** Checks custom-field values against the project's fields; returns the cleaned object. */
+function validateProperties(input, fields, { requireAll = false } = {}) {
+  if (input === null || typeof input !== "object" || Array.isArray(input)) throw new HttpError(400, "Properties must be an object.");
+  const byKey = new Map(fields.map((f) => [f.key, f]));
+  const out = {};
+  for (const [key, value] of Object.entries(input)) {
+    const f = byKey.get(key);
+    if (!f) throw new HttpError(400, `This project has no field called "${key}".`);
+    if (value === null || value === "" || (Array.isArray(value) && value.length === 0)) continue;
+    const fail = (what) => {
+      throw new HttpError(400, `${f.label} must be ${what}.`);
+    };
+    switch (f.type) {
+      case "text":
+        if (typeof value !== "string" || value.length > 500) fail("text up to 500 characters");
+        out[key] = value.trim();
+        break;
+      case "url":
+        if (typeof value !== "string" || !/^https?:\/\/\S+$/.test(value)) fail("a link starting with http:// or https://");
+        out[key] = value;
+        break;
+      case "number":
+        if (typeof value !== "number" || !Number.isFinite(value)) fail("a number");
+        out[key] = value;
+        break;
+      case "date":
+        if (typeof value !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(value)) fail("a date (YYYY-MM-DD)");
+        out[key] = value;
+        break;
+      case "checkbox":
+        if (typeof value !== "boolean") fail("checked or unchecked");
+        out[key] = value;
+        break;
+      case "select":
+        if (!f.options.includes(value)) fail(`one of: ${f.options.join(", ")}`);
+        out[key] = value;
+        break;
+      case "multi_select":
+        if (!Array.isArray(value) || value.some((x) => !f.options.includes(x))) fail(`any of: ${f.options.join(", ")}`);
+        out[key] = [...new Set(value)];
+        break;
+      default:
+        fail("a supported value");
+    }
+  }
+  if (requireAll) {
+    const missing = fields.filter((f) => f.required && f.type !== "checkbox" && out[f.key] === undefined);
+    if (missing.length) throw new HttpError(400, `Fill in ${missing.map((f) => f.label).join(", ")} first.`);
+  }
+  return out;
+}
+
+module.exports = { listColumns, listFrom, visibleTask, canEdit, canReview, validateProperties };
diff --git a/Back/src/modules/time/routes.js b/Back/src/modules/time/routes.js
new file mode 100644
index 0000000..bc70444
--- /dev/null
+++ b/Back/src/modules/time/routes.js
@@ -0,0 +1,147 @@
+// Time tracking: your clock and timers, work sessions, admin corrections with an audit trail,
+// and attendance for managers. All times come from the database clock, never the browser.
+const express = require("express");
+const sql = require("../../db");
+const v = require("../../lib/validate");
+const { HttpError, found, forbid } = require("../../lib/http");
+const { can, permit } = require("../../middleware/auth");
+const { peopleFilter, canSeeUser } = require("../../access");
+const { dayRange, todayInIndia } = require("../../lib/dates");
+const { visibleTask } = require("../tasks/service");
+
+const router = express.Router();
+
+/** Your current clock state: open session, running timer and today's totals. */
+async function myStatus(userId) {
+  const today = todayInIndia();
+  const [[session], [timer], [hours], [taskMinutes]] = await Promise.all([
+    sql`select id, clock_in from work_sessions where user_id = ${userId} and clock_out is null`,
+    sql`select l.id, l.started_at, l.task_id, p.key || '-' || t.number as task_key, t.title as task_title
+        from task_time_logs l join tasks t on t.id = l.task_id join projects p on p.id = t.project_id
+        where l.user_id = ${userId} and l.ended_at is null`,
+    sql`select coalesce(sum(hours_clocked), 0) as hours from v_daily_hours where user_id = ${userId} and day = ${today}`,
+    sql`select coalesce(round(sum(extract(epoch from coalesce(ended_at, now()) - started_at)) / 60), 0) as minutes
+        from task_time_logs where user_id = ${userId} and (started_at at time zone 'Asia/Kolkata')::date = ${today}`,
+  ]);
+  return { session: session ?? null, timer: timer ?? null, hours_today: Number(hours.hours), task_minutes_today: Number(taskMinutes.minutes) };
+}
+
+/** Requires time.track for your own clock. */
+function assertTracks(me) {
+  if (!can(me, "time.track")) forbid("Your role doesn't track time.");
+}
+
+/** GET /time/me — your clock state. */
+router.get("/me", async (req, res) => res.json(await myStatus(res.locals.me.id)));
+
+/** POST /time/clock-in — starts your work session. */
+router.post("/clock-in", async (req, res) => {
+  assertTracks(res.locals.me);
+  await sql`select clock_in(${res.locals.me.id})`;
+  res.json(await myStatus(res.locals.me.id));
+});
+
+/** POST /time/clock-out — ends your session (and any running timer). */
+router.post("/clock-out", async (req, res) => {
+  assertTracks(res.locals.me);
+  await sql`select clock_out(${res.locals.me.id})`;
+  res.json(await myStatus(res.locals.me.id));
+});
+
+/** POST /time/timer/start — starts a timer on one of your tasks (stopping any other). */
+router.post("/timer/start", async (req, res) => {
+  const me = res.locals.me;
+  assertTracks(me);
+  const task = await visibleTask(me, v.id(req.body?.task_id, "Task"));
+  if (task.assignee_id !== me.id) forbid("You can only time tasks assigned to you.");
+  if (task.status === "done") throw new HttpError(400, "This task is already done.");
+  await sql.begin(async (tx) => {
+    await tx`select start_task_timer(${me.id}, ${task.id})`;
+    if (task.status === "todo" || task.status === "rework") {
+      await tx`update tasks set status = 'in_progress', updated_by = ${me.id} where id = ${task.id}`;
+    }
+  });
+  res.json(await myStatus(me.id));
+});
+
+/** POST /time/timer/stop — stops your running timer. */
+router.post("/timer/stop", async (req, res) => {
+  assertTracks(res.locals.me);
+  await sql`select stop_task_timer(${res.locals.me.id})`;
+  res.json(await myStatus(res.locals.me.id));
+});
+
+/** GET /time/sessions — work sessions for you, or (with time.manage) someone you can see. */
+router.get("/sessions", async (req, res) => {
+  const me = res.locals.me;
+  const userId = req.query.user_id ? v.id(req.query.user_id, "user_id") : me.id;
+  if (userId !== me.id && !(can(me, "time.manage") || can(me, "people.view"))) forbid();
+  if (userId !== me.id && !(await canSeeUser(me, userId))) throw new HttpError(404, "That person wasn't found.");
+  const { from, to } = dayRange(req.query, 14);
+  const rows = await sql`
+    select s.id, s.clock_in, s.clock_out,
+           round(extract(epoch from coalesce(s.clock_out, now()) - s.clock_in) / 60) as minutes,
+           (select count(*) from time_corrections c where c.session_id = s.id) as corrections,
+           coalesce((select round(sum(extract(epoch from coalesce(l.ended_at, now()) - l.started_at)) / 60)
+                     from task_time_logs l where l.user_id = s.user_id and l.started_at >= s.clock_in
+                       and l.started_at < coalesce(s.clock_out, now())), 0) as task_minutes
+    from work_sessions s
+    where s.user_id = ${userId} and (s.clock_in at time zone 'Asia/Kolkata')::date between ${from} and ${to}
+    order by s.clock_in desc`;
+  res.json({ range: { from, to }, sessions: rows, can_correct: userId !== me.id && can(me, "time.manage") });
+});
+
+/** PATCH /time/sessions/:id — corrects someone's session with a reason (recorded). */
+router.patch("/sessions/:id", permit("time.manage"), async (req, res) => {
+  const me = res.locals.me;
+  const sessionId = v.id(req.params.id, "session id");
+  const [s] = await sql`select * from work_sessions where id = ${sessionId}`;
+  found(s, "That work session");
+  if (!(await canSeeUser(me, s.user_id))) throw new HttpError(404, "That work session wasn't found.");
+  if (s.user_id === me.id && !me.role.is_system) forbid("Ask someone else to correct your own time.");
+  const clockIn = v.timestamp(req.body?.clock_in, "Clock in") ?? s.clock_in.toISOString();
+  const clockOut = req.body?.clock_out === undefined ? s.clock_out?.toISOString() ?? null : v.timestamp(req.body.clock_out, "Clock out");
+  if (clockOut && new Date(clockOut) <= new Date(clockIn)) throw new HttpError(400, "Clock out must be after clock in.");
+  if (new Date(clockIn) > new Date() || (clockOut && new Date(clockOut) > new Date())) throw new HttpError(400, "Times can't be in the future.");
+  const reason = v.text(req.body?.reason, "Reason", { min: 3, max: 500 });
+  await sql`select correct_session(${sessionId}, ${me.id}, ${clockIn}, ${clockOut}, ${reason})`;
+  res.json({ ok: true });
+});
+
+/** GET /time/sessions/:id/corrections — the audit trail for one session. */
+router.get("/sessions/:id/corrections", async (req, res) => {
+  const me = res.locals.me;
+  const sessionId = v.id(req.params.id, "session id");
+  const [s] = await sql`select user_id from work_sessions where id = ${sessionId}`;
+  found(s, "That work session");
+  if (s.user_id !== me.id && !(await canSeeUser(me, s.user_id))) throw new HttpError(404, "That work session wasn't found.");
+  const rows = await sql`
+    select c.id, c.old_clock_in, c.old_clock_out, c.new_clock_in, c.new_clock_out, c.reason, c.created_at,
+           case when u.id is null then null else json_build_object('id', u.id, 'name', u.name) end as editor
+    from time_corrections c left join users u on u.id = c.editor_id where c.session_id = ${sessionId} order by c.created_at desc`;
+  res.json({ corrections: rows });
+});
+
+/** GET /time/attendance — who's clocked in now and hours per person per day, for people you can see. */
+router.get("/attendance", async (req, res) => {
+  const me = res.locals.me;
+  if (!(can(me, "people.view") || can(me, "time.manage") || can(me, "dashboard.view"))) forbid();
+  const { from, to } = dayRange(req.query, 7);
+  const [people, now, hours] = await Promise.all([
+    sql`select u.id, u.name, u.title, d.name as department_name from users u left join departments d on d.id = u.department_id
+        join roles r on r.id = u.role_id
+        where u.is_active and ${peopleFilter(me)} and exists (select 1 from role_permissions rp where rp.role_id = r.id and rp.permission = 'time.track')
+        order by lower(u.name)`,
+    sql`select s.id as session_id, s.user_id, s.clock_in, u.name,
+               (select json_build_object('key', p.key || '-' || t.number, 'title', t.title)
+                  from task_time_logs l join tasks t on t.id = l.task_id join projects p on p.id = t.project_id
+                 where l.user_id = s.user_id and l.ended_at is null) as working_on
+        from work_sessions s join users u on u.id = s.user_id
+        where s.clock_out is null and ${peopleFilter(me)} order by s.clock_in`,
+    sql`select h.user_id, h.day, h.hours_clocked from v_daily_hours h join users u on u.id = h.user_id
+        where h.day between ${from} and ${to} and ${peopleFilter(me)}`,
+  ]);
+  res.json({ range: { from, to }, people, clocked_in_now: now, daily_hours: hours });
+});
+
+module.exports = router;
diff --git a/Back/src/modules/users/routes.js b/Back/src/modules/users/routes.js
new file mode 100644
index 0000000..491f003
--- /dev/null
+++ b/Back/src/modules/users/routes.js
@@ -0,0 +1,139 @@
+// People accounts: listing, pickers, and admin management (add, edit, deactivate, delete).
+const express = require("express");
+const bcrypt = require("bcryptjs");
+const sql = require("../../db");
+const v = require("../../lib/validate");
+const { HttpError, found, forbid } = require("../../lib/http");
+const { permit, can } = require("../../middleware/auth");
+const { peopleFilter } = require("../../access");
+
+const router = express.Router();
+
+/** Selects a user's public fields (never the password hash). */
+const userColumns = sql`
+  u.id, u.name, u.email, u.title, u.is_active, u.created_at, u.department_id, u.role_id,
+  json_build_object('id', r.id, 'name', r.name, 'scope', r.scope) as role,
+  case when d.id is null then null else json_build_object('id', d.id, 'name', d.name) end as department`;
+
+/** Loads one user with role and department, or undefined. */
+async function getUser(id) {
+  const [u] = await sql`select ${userColumns} from users u join roles r on r.id = u.role_id
+                        left join departments d on d.id = u.department_id where u.id = ${id}`;
+  return u;
+}
+
+/** GET /users/options — active people you can see, for assignee and mention pickers. */
+router.get("/options", async (req, res) => {
+  const me = res.locals.me;
+  const rows = await sql`
+    select u.id, u.name, u.title, u.department_id, d.name as department_name
+    from users u left join departments d on d.id = u.department_id
+    where u.is_active and ${peopleFilter(me)} order by lower(u.name)`;
+  res.json({ users: rows });
+});
+
+/** GET /users — everyone you can see, with filters (?q, ?department_id, ?role_id, ?active). */
+router.get("/", async (req, res) => {
+  const me = res.locals.me;
+  if (!can(me, "people.view") && !can(me, "people.manage")) forbid();
+  const q = typeof req.query.q === "string" && req.query.q.trim() ? `%${req.query.q.trim().toLowerCase()}%` : null;
+  const dept = req.query.department_id ? v.id(req.query.department_id, "department_id") : null;
+  const role = req.query.role_id ? v.id(req.query.role_id, "role_id") : null;
+  const active = req.query.active === "true" ? true : req.query.active === "false" ? false : null;
+  const rows = await sql`
+    select ${userColumns} from users u join roles r on r.id = u.role_id left join departments d on d.id = u.department_id
+    where ${peopleFilter(me)}
+      ${q ? sql`and (lower(u.name) like ${q} or lower(u.email) like ${q} or lower(u.title) like ${q})` : sql``}
+      ${dept ? sql`and u.department_id = ${dept}` : sql``}
+      ${role ? sql`and u.role_id = ${role}` : sql``}
+      ${active === null ? sql`` : sql`and u.is_active = ${active}`}
+    order by lower(u.name)`;
+  res.json({ users: rows });
+});
+
+/** GET /users/:id — one person's account details. */
+router.get("/:id", async (req, res) => {
+  const me = res.locals.me;
+  const userId = v.id(req.params.id, "user id");
+  const [visible] = await sql`select 1 from users u where u.id = ${userId} and ${peopleFilter(me)}`;
+  if (!visible && userId !== me.id) throw new HttpError(404, "That person wasn't found.");
+  res.json({ user: found(await getUser(userId), "That person") });
+});
+
+/** Checks that a role and department exist before using them. */
+async function assertRefs(roleId, departmentId) {
+  if (roleId !== undefined) found((await sql`select 1 from roles where id = ${roleId}`)[0], "That role");
+  if (departmentId) found((await sql`select 1 from departments where id = ${departmentId}`)[0], "That department");
+}
+
+/** Only an Admin-role holder can hand out the Admin role. */
+async function assertCanGrantRole(me, roleId) {
+  const [role] = await sql`select is_system from roles where id = ${roleId}`;
+  if (role?.is_system && !me.role.is_system) forbid("Only admins can give someone the Admin role.");
+}
+
+/** POST /users — adds a person with a starting password. */
+router.post("/", permit("people.manage"), async (req, res) => {
+  const b = req.body ?? {};
+  const user = {
+    name: v.personName(b.name),
+    email: v.email(b.email),
+    title: v.optionalText(b.title, "Job title", { max: 80 }) ?? "",
+    role_id: v.id(b.role_id, "Role"),
+    department_id: b.department_id === undefined ? null : v.nullableId(b.department_id, "Department"),
+  };
+  const password = v.password(b.password);
+  await assertRefs(user.role_id, user.department_id);
+  await assertCanGrantRole(res.locals.me, user.role_id);
+  const [row] = await sql`insert into users ${sql({ ...user, password_hash: await bcrypt.hash(password, 12) })} returning id`;
+  res.status(201).json({ user: await getUser(row.id) });
+});
+
+/** PATCH /users/:id — edits a person; you can't change your own role or deactivate yourself. */
+router.patch("/:id", permit("people.manage"), async (req, res) => {
+  const me = res.locals.me;
+  const userId = v.id(req.params.id, "user id");
+  const current = found(await getUser(userId), "That person");
+  const b = req.body ?? {};
+  const changes = {};
+  if (b.name !== undefined) changes.name = v.personName(b.name);
+  if (b.email !== undefined) changes.email = v.email(b.email);
+  if (b.title !== undefined) changes.title = v.optionalText(b.title, "Job title", { max: 80 });
+  if (b.department_id !== undefined) changes.department_id = v.nullableId(b.department_id, "Department");
+  if (b.role_id !== undefined) changes.role_id = v.id(b.role_id, "Role");
+  if (b.is_active !== undefined) changes.is_active = v.bool(b.is_active, "Active");
+  if (b.password !== undefined) changes.password_hash = await bcrypt.hash(v.password(b.password), 12);
+  if (!Object.keys(changes).length) throw new HttpError(400, "Nothing to change.");
+
+  if (userId === me.id && changes.role_id !== undefined && changes.role_id !== current.role_id) {
+    throw new HttpError(400, "You can't change your own role. Ask another admin.");
+  }
+  if (userId === me.id && changes.is_active === false) throw new HttpError(400, "You can't deactivate your own account.");
+  const [target] = await sql`select r.is_system from users u join roles r on r.id = u.role_id where u.id = ${userId}`;
+  if (target.is_system && !me.role.is_system) forbid("Only admins can edit an admin's account.");
+  await assertRefs(changes.role_id, changes.department_id);
+  if (changes.role_id !== undefined) await assertCanGrantRole(me, changes.role_id);
+
+  await sql`update users set ${sql(changes)} where id = ${userId}`;
+  res.json({ user: await getUser(userId) });
+});
+
+/** DELETE /users/:id — deletes someone with no history; anyone with history must be deactivated. */
+router.delete("/:id", permit("people.manage"), async (req, res) => {
+  const me = res.locals.me;
+  const userId = v.id(req.params.id, "user id");
+  if (userId === me.id) throw new HttpError(400, "You can't delete your own account.");
+  found(await getUser(userId), "That person");
+  const [history] = await sql`
+    select (select count(*) from tasks where assignee_id = ${userId} or reporter_id = ${userId})
+         + (select count(*) from work_sessions where user_id = ${userId})
+         + (select count(*) from task_reviews where reviewer_id = ${userId} or assignee_id = ${userId})
+         + (select count(*) from task_comments where author_id = ${userId}) as n`;
+  if (history.n > 0) {
+    throw new HttpError(409, "This person has tasks, time or reviews, so they can't be deleted. Deactivate them instead to keep their history.");
+  }
+  await sql`delete from users where id = ${userId}`;
+  res.status(204).end();
+});
+
+module.exports = router;
