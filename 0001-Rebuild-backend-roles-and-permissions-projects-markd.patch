--- /dev/null
+++ b/Back/src/lib/markdown.js
@@ -0,0 +1,59 @@
+// Converts tasks to and from Markdown files with YAML front matter, e.g.
+//   ---
+//   title: Login screen
+//   status: in_progress
+//   priority: high
+//   assignee: priya
+//   properties: { component: Frontend }
+//   ---
+//   ## What
+//   ...
+const YAML = require("yaml");
+const { HttpError } = require("./http");
+
+/** Builds a .md document for a task. */
+function taskToMarkdown(task) {
+  const front = {
+    key: task.key,
+    title: task.title,
+    project: task.project?.key ?? null,
+    status: task.status,
+    priority: task.priority,
+    assignee: task.assignee?.name ?? null,
+    start_date: task.start_date ?? null,
+    deadline: task.deadline ? new Date(task.deadline).toISOString() : null,
+    estimate_minutes: task.estimate_minutes ?? null,
+    labels: task.labels ?? [],
+    properties: task.properties ?? {},
+  };
+  return `---\n${YAML.stringify(front).trimEnd()}\n---\n\n${task.body_md ?? ""}\n`;
+}
+
+/** Splits a .md document into front matter (object) and body (string). */
+function parseMarkdown(text) {
+  if (typeof text !== "string" || !text.trim()) throw new HttpError(400, "The file is empty.");
+  if (text.length > 120000) throw new HttpError(413, "That file is too large to import.");
+  const normalized = text.replace(/^﻿/, "").replace(/\r\n/g, "\n");
+  const match = /^---\n([\s\S]*?)\n---\n?/.exec(normalized);
+  let front = {};
+  if (match) {
+    try {
+      front = YAML.parse(match[1]) ?? {};
+    } catch {
+      throw new HttpError(400, "The properties block at the top of the file isn't valid YAML.");
+    }
+    if (typeof front !== "object" || Array.isArray(front)) throw new HttpError(400, "The properties block must be a set of key: value lines.");
+  }
+  let body = match ? normalized.slice(match[0].length) : normalized;
+  // No title in front matter: use the first "# Heading" line and drop it from the body.
+  if (!front.title) {
+    const h = /^\s*#\s+(.+)\n?/.exec(body);
+    if (h) {
+      front.title = h[1].trim();
+      body = body.slice(h[0].length);
+    }
+  }
+  return { front, body: body.replace(/^\n+/, "") };
+}
+
+module.exports = { taskToMarkdown, parseMarkdown };
diff --git a/Back/src/lib/validate.js b/Back/src/lib/validate.js
new file mode 100644
index 0000000..ffb59b8
--- /dev/null
+++ b/Back/src/lib/validate.js
@@ -0,0 +1,100 @@
+// Input validators. Each returns the cleaned value or throws a 400 that names the field.
+const { HttpError } = require("./http");
+
+const bad = (msg) => new HttpError(400, msg);
+const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+/** A trimmed string between min and max characters. */
+function text(value, label, { min = 1, max = 200 } = {}) {
+  if (typeof value !== "string") throw bad(`${label} is required.`);
+  const v = value.trim();
+  if (v.length < min || v.length > max) {
+    throw bad(min > 1 || max < 200 ? `${label} must be ${min} to ${max} characters.` : `${label} is required.`);
+  }
+  return v;
+}
+
+/** Optional string: undefined stays undefined, "" becomes "", otherwise like text(). */
+function optionalText(value, label, opts = {}) {
+  if (value === undefined) return undefined;
+  if (value === null || value === "") return "";
+  return text(value, label, { min: 0, ...opts });
+}
+
+/** A positive integer id. */
+function id(value, label = "id") {
+  const n = Number(value);
+  if (!Number.isSafeInteger(n) || n <= 0) throw bad(`${label} must be a positive whole number.`);
+  return n;
+}
+
+/** An id or null (to clear a reference). */
+function nullableId(value, label) {
+  return value === null || value === "" ? null : id(value, label);
+}
+
+/** One of the allowed values. */
+function oneOf(value, allowed, label) {
+  if (!allowed.includes(value)) throw bad(`${label} must be one of: ${allowed.join(", ")}.`);
+  return value;
+}
+
+/** true or false. */
+function bool(value, label) {
+  if (typeof value !== "boolean") throw bad(`${label} must be true or false.`);
+  return value;
+}
+
+/** A whole number within range. */
+function int(value, label, { min = -Infinity, max = Infinity } = {}) {
+  const n = Number(value);
+  if (!Number.isInteger(n) || n < min || n > max) throw bad(`${label} must be a whole number from ${min} to ${max}.`);
+  return n;
+}
+
+/** An ISO timestamp, or null to clear it. */
+function timestamp(value, label) {
+  if (value === null || value === "") return null;
+  const d = new Date(value);
+  if (typeof value !== "string" || Number.isNaN(d.getTime())) throw bad(`${label} must be a date and time.`);
+  return d.toISOString();
+}
+
+/** A YYYY-MM-DD date, or null to clear it. */
+function day(value, label) {
+  if (value === null || value === "") return null;
+  if (typeof value !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(value) || Number.isNaN(Date.parse(value))) {
+    throw bad(`${label} must be a date (YYYY-MM-DD).`);
+  }
+  return value;
+}
+
+/** A lower-cased email address. */
+function email(value) {
+  const v = text(value, "Email", { max: 254 }).toLowerCase();
+  if (!EMAIL.test(v)) throw bad("Enter a valid email address.");
+  return v;
+}
+
+/** A person's name; it doubles as their username, so no "@". */
+function personName(value) {
+  const v = text(value, "Name", { min: 2, max: 60 });
+  if (v.includes("@")) throw bad("Name can't contain @, because it's also used as the username.");
+  return v;
+}
+
+/** A password of reasonable length. */
+function password(value) {
+  if (typeof value !== "string" || value.length < 8 || value.length > 128) throw bad("Password must be 8 to 128 characters.");
+  return value;
+}
+
+/** A list of short labels: trimmed, lower-cased, de-duplicated. */
+function labels(value) {
+  if (!Array.isArray(value)) throw bad("Labels must be a list.");
+  const out = [...new Set(value.map((l) => text(l, "Each label", { max: 40 }).toLowerCase()))];
+  if (out.length > 20) throw bad("Use at most 20 labels.");
+  return out;
+}
+
+module.exports = { text, optionalText, id, nullableId, oneOf, bool, int, timestamp, day, email, personName, password, labels };
diff --git a/Back/src/middleware/auth.js b/Back/src/middleware/auth.js
new file mode 100644
index 0000000..afc4b09
--- /dev/null
+++ b/Back/src/middleware/auth.js
@@ -0,0 +1,94 @@
+// Session handling: signs the login cookie, and on every request re-loads the user with their
+// role, scope and permissions, so role changes and deactivation apply immediately.
+const jwt = require("jsonwebtoken");
+const config = require("../config");
+const sql = require("../db");
+const { forbid } = require("../lib/http");
+
+const COOKIE = "task_session";
+const SESSION_MS = 8 * 60 * 60 * 1000;
+const cookieOptions = { httpOnly: true, secure: config.production, sameSite: "lax", path: "/" };
+
+/** Issues the session cookie for a user id. */
+function startSession(res, userId) {
+  const token = jwt.sign({}, config.jwtSecret, { algorithm: "HS256", subject: String(userId), expiresIn: "8h", ...config.jwtOptions });
+  res.cookie(COOKIE, token, { ...cookieOptions, maxAge: SESSION_MS });
+}
+
+/** Clears the session cookie. */
+function endSession(res) {
+  res.clearCookie(COOKIE, cookieOptions);
+}
+
+/** Loads a user with role and permissions, in the shape every module uses as `me`. */
+async function loadUser(userId) {
+  const [row] = await sql`
+    select u.id, u.name, u.email, u.title, u.department_id, u.is_active,
+           r.id as role_id, r.name as role_name, r.scope, r.is_system,
+           d.name as department_name,
+           coalesce(array_agg(rp.permission) filter (where rp.permission is not null), '{}') as permissions
+    from users u
+    join roles r on r.id = u.role_id
+    left join departments d on d.id = u.department_id
+    left join role_permissions rp on rp.role_id = r.id
+    where u.id = ${userId}
+    group by u.id, r.id, d.name`;
+  if (!row) return null;
+  return {
+    id: row.id,
+    name: row.name,
+    email: row.email,
+    title: row.title,
+    department_id: row.department_id,
+    department_name: row.department_name,
+    is_active: row.is_active,
+    role: { id: row.role_id, name: row.role_name, scope: row.scope, is_system: row.is_system },
+    permissions: new Set(row.permissions),
+  };
+}
+
+/** Converts `me` to JSON for the browser (permissions as a sorted list). */
+function publicMe(me) {
+  return { ...me, permissions: [...me.permissions].sort() };
+}
+
+/** Rejects requests without a valid session; puts the current user on res.locals.me. */
+async function requireAuth(req, res, next) {
+  const token = req.cookies?.[COOKIE];
+  if (!token) return res.status(401).json({ error: "Sign in to continue." });
+  let payload;
+  try {
+    payload = jwt.verify(token, config.jwtSecret, { algorithms: ["HS256"], ...config.jwtOptions });
+  } catch {
+    return res.status(401).json({ error: "Your session has expired. Sign in again." });
+  }
+  const me = await loadUser(Number(payload.sub));
+  if (!me || !me.is_active) return res.status(401).json({ error: "Your session has expired. Sign in again." });
+  res.locals.me = me;
+  return next();
+}
+
+/** True when the user has the permission. */
+function can(me, permission) {
+  return me.permissions.has(permission);
+}
+
+/** Middleware: requires every listed permission. */
+function permit(...permissions) {
+  return (req, res, next) => {
+    const me = res.locals.me;
+    if (!permissions.every((p) => can(me, p))) forbid();
+    next();
+  };
+}
+
+/** Middleware: requires at least one of the listed permissions. */
+function permitAny(...permissions) {
+  return (req, res, next) => {
+    const me = res.locals.me;
+    if (!permissions.some((p) => can(me, p))) forbid();
+    next();
+  };
+}
+
+module.exports = { startSession, endSession, loadUser, publicMe, requireAuth, can, permit, permitAny };
diff --git a/Back/src/middleware/errors.js b/Back/src/middleware/errors.js
new file mode 100644
index 0000000..37b32ce
--- /dev/null
+++ b/Back/src/middleware/errors.js
@@ -0,0 +1,43 @@
+// Turns thrown errors into JSON responses. Database constraint errors become messages a person
+// can act on; anything unexpected is logged and hidden behind a generic 500.
+const { HttpError } = require("../lib/http");
+
+// Friendly messages for named constraints from db/migrations.
+const CONSTRAINTS = {
+  users_email_uq: [409, "Someone already uses that email."],
+  users_name_uq: [409, "That name is taken. Choose another."],
+  roles_name_uq: [409, "A role with that name already exists."],
+  departments_name_uq: [409, "A department with that name already exists."],
+  projects_key_uq: [409, "Another project already uses that key."],
+  project_fields_project_id_key_key: [409, "This project already has a field with that key."],
+  work_sessions_one_open: [409, "You're already clocked in."],
+  work_sessions_user_id_tstzrange_excl: [409, "That time overlaps another work session."],
+  task_time_logs_one_running: [409, "A timer is already running."],
+};
+
+/** Maps a Postgres error to [status, message], or null when it isn't one we expect. */
+function fromPostgres(error) {
+  if (CONSTRAINTS[error.constraint_name]) return CONSTRAINTS[error.constraint_name];
+  if (error.code === "P0001") return [400, error.message];
+  if (error.code === "P0002") return [409, error.message];
+  if (error.code === "23505") return [409, "That already exists."];
+  if (error.code === "23503") return [400, "That refers to something that doesn't exist, or something still depends on it."];
+  if (error.code === "23514") return [400, "Some of the values aren't allowed."];
+  if (error.code === "23P01") return [409, "That overlaps something that already exists."];
+  if (error.code === "22P02") return [400, "Some of the values aren't in the right format."];
+  return null;
+}
+
+/** Express error handler (registered last). */
+// eslint-disable-next-line no-unused-vars
+function errorHandler(error, req, res, next) {
+  if (error instanceof HttpError) return res.status(error.status).json({ error: error.message });
+  if (error?.type === "entity.parse.failed") return res.status(400).json({ error: "The request body must be valid JSON." });
+  if (error?.type === "entity.too.large") return res.status(413).json({ error: "That's too large to save." });
+  const mapped = error?.code ? fromPostgres(error) : null;
+  if (mapped) return res.status(mapped[0]).json({ error: mapped[1] });
+  console.error(`${req.method} ${req.originalUrl} failed:`, error);
+  return res.status(500).json({ error: "Something went wrong on the server. Try again." });
+}
+
+module.exports = { errorHandler, fromPostgres };
diff --git a/Back/src/modules/auth/routes.js b/Back/src/modules/auth/routes.js
new file mode 100644
index 0000000..f6e7079
--- /dev/null
+++ b/Back/src/modules/auth/routes.js
@@ -0,0 +1,58 @@
+// Sign in, sign out, the current user, and changing your own password.
+const express = require("express");
+const bcrypt = require("bcryptjs");
+const { rateLimit } = require("express-rate-limit");
+const sql = require("../../db");
+const v = require("../../lib/validate");
+const { HttpError } = require("../../lib/http");
+const { startSession, endSession, loadUser, publicMe, requireAuth } = require("../../middleware/auth");
+
+const router = express.Router();
+
+const loginLimit = rateLimit({
+  windowMs: 15 * 60 * 1000,
+  limit: 10,
+  skip: () => process.env.NODE_ENV === "test",
+  standardHeaders: "draft-8",
+  legacyHeaders: false,
+  message: { error: "Too many sign-in attempts. Wait 15 minutes and try again." },
+});
+
+/** POST /auth/login — signs in with a username or email and a password. */
+router.post("/login", loginLimit, async (req, res) => {
+  const identifier = v.text(req.body?.identifier, "Username or email", { max: 254 });
+  const password = typeof req.body?.password === "string" ? req.body.password : "";
+  const [user] = await sql`
+    select id, password_hash, is_active from users
+    where lower(email) = ${identifier.toLowerCase()} or lower(name) = ${identifier.toLowerCase()}
+    limit 1`;
+  const ok = user && password && (await bcrypt.compare(password, user.password_hash));
+  if (!ok) throw new HttpError(401, "That username, email or password isn't right.");
+  if (!user.is_active) throw new HttpError(403, "This account has been deactivated. Contact your admin.");
+  startSession(res, user.id);
+  res.json({ user: publicMe(await loadUser(user.id)) });
+});
+
+/** POST /auth/logout — ends the session. */
+router.post("/logout", (req, res) => {
+  endSession(res);
+  res.status(204).end();
+});
+
+/** GET /auth/me — the signed-in user, role and permissions. */
+router.get("/me", requireAuth, (req, res) => {
+  res.json({ user: publicMe(res.locals.me) });
+});
+
+/** POST /auth/password — changes your own password after checking the current one. */
+router.post("/password", requireAuth, async (req, res) => {
+  const next = v.password(req.body?.new_password);
+  const [row] = await sql`select password_hash from users where id = ${res.locals.me.id}`;
+  if (!(await bcrypt.compare(String(req.body?.current_password ?? ""), row.password_hash))) {
+    throw new HttpError(400, "Your current password isn't right.");
+  }
+  await sql`update users set password_hash = ${await bcrypt.hash(next, 12)} where id = ${res.locals.me.id}`;
+  res.status(204).end();
+});
+
+module.exports = router;
diff --git a/Back/src/modules/comments/routes.js b/Back/src/modules/comments/routes.js
new file mode 100644
index 0000000..d88a14b
--- /dev/null
+++ b/Back/src/modules/comments/routes.js
@@ -0,0 +1,61 @@
+// Comments on tasks. @name mentions notify that person; the assignee and reporter hear about new comments.
+const express = require("express");
+const sql = require("../../db");
+const v = require("../../lib/validate");
+const { HttpError, found, forbid } = require("../../lib/http");
+const { can } = require("../../middleware/auth");
+const { notify } = require("../notifications/service");
+const { visibleTask } = require("../tasks/service");
+
+const router = express.Router();
+
+/** Finds the ids of people @mentioned in a comment. */
+async function mentionedIds(tx, body) {
+  const names = [...new Set([...body.matchAll(/(?:^|\s)@([A-Za-z0-9._-]{2,60})/g)].map((m) => m[1].toLowerCase()))];
+  if (!names.length) return [];
+  return (await tx`select id from users where lower(name) = any(${names}::text[]) and is_active`).map((u) => u.id);
+}
+
+/** POST /tasks/:id/comments — adds a comment. */
+router.post("/tasks/:id/comments", async (req, res) => {
+  const me = res.locals.me;
+  const task = await visibleTask(me, v.id(req.params.id, "task id"));
+  const body = v.text(req.body?.body_md, "Comment", { max: 10000 });
+  const comment = await sql.begin(async (tx) => {
+    const [c] = await tx`insert into task_comments (task_id, author_id, body_md) values (${task.id}, ${me.id}, ${body}) returning *`;
+    await tx`insert into task_events (task_id, actor_id, type, data) values (${task.id}, ${me.id}, 'comment', ${tx.json({ comment_id: c.id })})`;
+    const mentions = await mentionedIds(tx, body);
+    await notify(tx, { userIds: [task.assignee_id, task.reporter_id, ...mentions], type: "comment", title: `${me.name} commented on ${task.key}`, body: body.slice(0, 200), taskId: task.id, actorId: me.id });
+    return c;
+  });
+  res.status(201).json({ comment: { ...comment, author: { id: me.id, name: me.name } } });
+});
+
+/** Loads a comment whose task `me` can see. */
+async function visibleComment(me, id) {
+  const [c] = await sql`select * from task_comments where id = ${id}`;
+  found(c, "That comment");
+  await visibleTask(me, c.task_id);
+  return c;
+}
+
+/** PATCH /comments/:id — the author edits their comment. */
+router.patch("/comments/:id", async (req, res) => {
+  const me = res.locals.me;
+  const c = await visibleComment(me, v.id(req.params.id, "comment id"));
+  if (c.author_id !== me.id) forbid("You can only edit your own comments.");
+  const body = v.text(req.body?.body_md, "Comment", { max: 10000 });
+  const [row] = await sql`update task_comments set body_md = ${body}, edited_at = now() where id = ${c.id} returning *`;
+  res.json({ comment: { ...row, author: { id: me.id, name: me.name } } });
+});
+
+/** DELETE /comments/:id — the author, or someone who can edit any task, removes a comment. */
+router.delete("/comments/:id", async (req, res) => {
+  const me = res.locals.me;
+  const c = await visibleComment(me, v.id(req.params.id, "comment id"));
+  if (c.author_id !== me.id && !can(me, "tasks.edit_any")) forbid("You can only delete your own comments.");
+  await sql`delete from task_comments where id = ${c.id}`;
+  res.status(204).end();
+});
+
+module.exports = router;
diff --git a/Back/src/modules/dashboard/routes.js b/Back/src/modules/dashboard/routes.js
new file mode 100644
index 0000000..f26bb49
--- /dev/null
+++ b/Back/src/modules/dashboard/routes.js
@@ -0,0 +1,118 @@
+// The overview dashboard. Everything is limited to the viewer's scope: a department manager sees
+// their department, an Admin or HR sees the whole company.
+const express = require("express");
+const sql = require("../../db");
+const { permit } = require("../../middleware/auth");
+const { taskFilter, projectFilter, peopleFilter, departmentFilter } = require("../../access");
+const { todayInIndia } = require("../../lib/dates");
+
+const router = express.Router();
+const TREND_DAYS = 14;
+
+/** GET /dashboard/summary — KPIs, attention lists, projects by department, departments, trend and activity. */
+router.get("/summary", permit("dashboard.view"), async (req, res) => {
+  const me = res.locals.me;
+  const today = todayInIndia();
+  const weekStart = todayInIndia(-6);
+  const trendStart = todayInIndia(-(TREND_DAYS - 1));
+  const attention = (where) => sql`
+    select t.id, p.key || '-' || t.number as key, t.title, t.status, t.priority, t.deadline,
+           (t.status <> 'done' and t.deadline < now()) as overdue,
+           json_build_object('id', p.id, 'name', p.name) as project,
+           case when a.id is null then null else json_build_object('id', a.id, 'name', a.name) end as assignee
+    from tasks t join projects p on p.id = t.project_id left join users a on a.id = t.assignee_id
+    where ${taskFilter(me)} and ${where}`;
+
+  const [[counts], [people], projects, departments, review, overdue, dueSoon, clock, trend, activity] = await Promise.all([
+    sql`select count(*) filter (where t.status = 'todo') as not_started,
+               count(*) filter (where t.status in ('in_progress', 'in_review', 'rework')) as pending,
+               count(*) filter (where t.status = 'in_progress') as in_progress,
+               count(*) filter (where t.status = 'in_review') as in_review,
+               count(*) filter (where t.status = 'rework') as rework,
+               count(*) filter (where t.status = 'done') as completed,
+               count(*) filter (where t.status = 'done' and t.completed_at > now() - interval '7 days') as completed_this_week,
+               count(*) filter (where t.status <> 'done' and t.deadline < now()) as overdue,
+               count(*) filter (where t.status <> 'done' and t.deadline between now() and now() + interval '7 days') as due_this_week,
+               count(*) as total
+        from tasks t where ${taskFilter(me)}`,
+    sql`select count(*) filter (where u.is_active) as active, count(*) filter (where not u.is_active) as inactive,
+               (select count(*) from work_sessions s where s.clock_out is null
+                  and s.user_id in (select u.id from users u where ${peopleFilter(me)})) as clocked_in_now,
+               coalesce((select sum(h.hours_clocked) from v_daily_hours h where h.day = ${today} and h.user_id in (select u.id from users u where ${peopleFilter(me)})), 0) as hours_today
+        from users u where ${peopleFilter(me)}`,
+    sql`select p.id, p.key, p.name, p.status, p.deadline,
+               (p.status <> 'completed' and p.deadline < now()) as overdue,
+               count(t.id) as task_count, count(t.id) filter (where t.status = 'done') as tasks_done,
+               count(t.id) filter (where t.status <> 'done' and t.deadline < now()) as tasks_overdue,
+               coalesce(json_agg(json_build_object('department_id', a.department_id, 'done', t.status = 'done')) filter (where t.id is not null), '[]') as task_departments
+        from projects p left join tasks t on t.project_id = p.id left join users a on a.id = t.assignee_id
+        where ${projectFilter(me)}
+        group by p.id
+        order by case p.status when 'active' then 0 when 'planned' then 1 when 'on_hold' then 2 else 3 end, p.deadline nulls last`,
+    sql`select d.id, d.name,
+               (select count(*) from users u where u.department_id = d.id and u.is_active) as members,
+               (select count(*) from work_sessions s join users u on u.id = s.user_id where u.department_id = d.id and s.clock_out is null) as active_now,
+               (select count(*) from tasks t join users u on u.id = t.assignee_id where u.department_id = d.id and t.status <> 'done') as open_tasks,
+               (select count(*) from tasks t join users u on u.id = t.assignee_id where u.department_id = d.id and t.status <> 'done' and t.deadline < now()) as overdue_tasks,
+               (select count(*) from tasks t join users u on u.id = t.assignee_id where u.department_id = d.id and t.status = 'done') as completed_tasks,
+               coalesce((select sum(h.hours_clocked) from v_daily_hours h join users u on u.id = h.user_id where u.department_id = d.id and h.day >= ${weekStart}), 0) as hours_week,
+               coalesce((select round(sum(extract(epoch from coalesce(l.ended_at, now()) - l.started_at)) / 3600, 1) from task_time_logs l join users u on u.id = l.user_id
+                         where u.department_id = d.id and (l.started_at at time zone 'Asia/Kolkata')::date >= ${weekStart}), 0) as timer_hours_week,
+               (select round(avg(rv.rating), 1) from task_reviews rv join users u on u.id = rv.assignee_id where u.department_id = d.id and rv.decision = 'approved') as avg_rating
+        from departments d where ${departmentFilter(me)} order by lower(d.name)`,
+    attention(sql`t.status = 'in_review'`),
+    attention(sql`t.status <> 'done' and t.deadline < now()`),
+    attention(sql`t.status <> 'done' and t.deadline between now() and now() + interval '7 days'`),
+    sql`select s.user_id, s.clock_in, u.name, u.department_id,
+               (select p.key || '-' || t.number from task_time_logs l join tasks t on t.id = l.task_id join projects p on p.id = t.project_id
+                 where l.user_id = s.user_id and l.ended_at is null) as working_on
+        from work_sessions s join users u on u.id = s.user_id where s.clock_out is null and ${peopleFilter(me)} order by s.clock_in`,
+    sql`select h.day, u.department_id, sum(h.hours_clocked) as hours from v_daily_hours h join users u on u.id = h.user_id
+        where h.day >= ${trendStart} and ${peopleFilter(me)} group by h.day, u.department_id`,
+    sql`select e.id, e.type, e.data, e.created_at, t.id as task_id, p.key || '-' || t.number as task_key, t.title as task_title,
+               case when a.id is null then null else json_build_object('id', a.id, 'name', a.name) end as actor
+        from task_events e join tasks t on t.id = e.task_id join projects p on p.id = t.project_id left join users a on a.id = e.actor_id
+        where ${taskFilter(me)} and e.type in ('created', 'status', 'review', 'comment') order by e.created_at desc limit 10`,
+  ]);
+
+  const sortByDeadline = (rows) => rows.sort((a, b) => new Date(a.deadline ?? 8.64e15) - new Date(b.deadline ?? 8.64e15));
+  const list = (rows) => ({ count: rows.length, tasks: sortByDeadline(rows).slice(0, 6) });
+  const days = Array.from({ length: TREND_DAYS }, (_, i) => todayInIndia(i - (TREND_DAYS - 1)));
+  const deptIds = [...departments.map((d) => d.id), null];
+
+  res.json({
+    date: today,
+    scope: me.role.scope,
+    department: me.role.scope === "all" ? null : { id: me.department_id, name: me.department_name },
+    people: { ...people, hours_today: Number(people.hours_today) },
+    tasks: counts,
+    attention: { waiting_review: list(review), overdue: list(overdue), due_soon: list(dueSoon) },
+    on_the_clock: clock,
+    projects: projects.map(({ task_departments, ...p }) => {
+      const byDept = new Map();
+      for (const t of task_departments) {
+        const b = byDept.get(t.department_id) ?? { department_id: t.department_id, total: 0, done: 0 };
+        b.total += 1;
+        if (t.done) b.done += 1;
+        byDept.set(t.department_id, b);
+      }
+      return { ...p, progress_pct: p.task_count ? Math.round((100 * p.tasks_done) / p.task_count) : 0, by_department: [...byDept.values()] };
+    }),
+    departments: departments.map((d) => ({
+      ...d,
+      hours_week: Number(d.hours_week),
+      timer_hours_week: Number(d.timer_hours_week),
+      utilization_pct: Number(d.hours_week) > 0 ? Math.min(100, Math.round((100 * Number(d.timer_hours_week)) / Number(d.hours_week))) : null,
+    })),
+    hours_trend: {
+      days,
+      series: deptIds.map((id) => ({
+        department_id: id,
+        values: days.map((day) => Number(trend.find((r) => r.day === day && r.department_id === id)?.hours ?? 0)),
+      })).filter((s) => s.values.some((x) => x > 0)),
+    },
+    activity,
+  });
+});
+
+module.exports = router;
diff --git a/Back/src/modules/departments/routes.js b/Back/src/modules/departments/routes.js
new file mode 100644
index 0000000..ef21f65
--- /dev/null
+++ b/Back/src/modules/departments/routes.js
@@ -0,0 +1,72 @@
+// Departments: the list everyone sees, and management for people with departments.manage.
+const express = require("express");
+const sql = require("../../db");
+const v = require("../../lib/validate");
+const { HttpError, found } = require("../../lib/http");
+const { permit } = require("../../middleware/auth");
+
+const router = express.Router();
+
+/** Loads departments with head, member and project counts. */
+async function listDepartments(id) {
+  return sql`
+    select d.id, d.name, d.description, d.head_id,
+           case when h.id is null then null else json_build_object('id', h.id, 'name', h.name) end as head,
+           (select count(*) from users u where u.department_id = d.id and u.is_active) as members,
+           (select count(*) from projects p where p.department_id = d.id) as projects
+    from departments d left join users h on h.id = d.head_id
+    ${id ? sql`where d.id = ${id}` : sql``}
+    order by lower(d.name)`;
+}
+
+/** GET /departments — every department (names are not sensitive). */
+router.get("/", async (req, res) => {
+  res.json({ departments: await listDepartments() });
+});
+
+/** Validates the head: must be an existing person. */
+async function validHead(value) {
+  if (value === undefined) return undefined;
+  const headId = v.nullableId(value, "Department head");
+  if (headId) found((await sql`select 1 from users where id = ${headId}`)[0], "That person");
+  return headId;
+}
+
+/** POST /departments — creates a department. */
+router.post("/", permit("departments.manage"), async (req, res) => {
+  const b = req.body ?? {};
+  const row = {
+    name: v.text(b.name, "Department name", { min: 2, max: 60 }),
+    description: v.optionalText(b.description, "Description", { max: 300 }) ?? "",
+    head_id: (await validHead(b.head_id)) ?? null,
+  };
+  const [d] = await sql`insert into departments ${sql(row)} returning id`;
+  res.status(201).json({ department: (await listDepartments(d.id))[0] });
+});
+
+/** PATCH /departments/:id — renames, re-describes or changes the head. */
+router.patch("/:id", permit("departments.manage"), async (req, res) => {
+  const id = v.id(req.params.id, "department id");
+  found((await listDepartments(id))[0], "That department");
+  const b = req.body ?? {};
+  const changes = {};
+  if (b.name !== undefined) changes.name = v.text(b.name, "Department name", { min: 2, max: 60 });
+  if (b.description !== undefined) changes.description = v.optionalText(b.description, "Description", { max: 300 });
+  if (b.head_id !== undefined) changes.head_id = await validHead(b.head_id);
+  if (!Object.keys(changes).length) throw new HttpError(400, "Nothing to change.");
+  await sql`update departments set ${sql(changes)} where id = ${id}`;
+  res.json({ department: (await listDepartments(id))[0] });
+});
+
+/** DELETE /departments/:id — deletes an empty department. */
+router.delete("/:id", permit("departments.manage"), async (req, res) => {
+  const id = v.id(req.params.id, "department id");
+  const d = found((await listDepartments(id))[0], "That department");
+  if (d.members > 0 || d.projects > 0) {
+    throw new HttpError(409, `Move this department's ${d.members} people and ${d.projects} projects elsewhere before deleting it.`);
+  }
+  await sql`delete from departments where id = ${id}`;
+  res.status(204).end();
+});
+
+module.exports = router;
diff --git a/Back/src/modules/notifications/routes.js b/Back/src/modules/notifications/routes.js
