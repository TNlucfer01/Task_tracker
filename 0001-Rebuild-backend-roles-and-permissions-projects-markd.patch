+  ('Team lead', 'tasks.edit_any'), ('Team lead', 'reviews.perform'), ('Team lead', 'time.track'),
+  ('HR', 'dashboard.view'), ('HR', 'people.view'), ('HR', 'people.manage'), ('HR', 'departments.manage'),
+  ('HR', 'time.manage'), ('HR', 'reports.export'), ('HR', 'time.track'),
