+// People performance: the team table and one person's work in detail.
+const express = require("express");
+const sql = require("../../db");
+const v = require("../../lib/validate");
+const { found } = require("../../lib/http");
+const { permit } = require("../../middleware/auth");
+const { dayRange } = require("../../lib/dates");
+const { peopleStats } = require("./stats");
+
+const router = express.Router();
+router.use(permit("people.view"));
+
+/** GET /people — performance for everyone you can see (?from&to). */
+router.get("/", async (req, res) => {
+  const range = dayRange(req.query, 30);
+  res.json({ range, people: await peopleStats(res.locals.me, range) });
+});
+
+/** GET /people/:id — one person: stats, tasks, daily hours, reviews and recent activity. */
+router.get("/:id", async (req, res) => {
+  const me = res.locals.me;
+  const userId = v.id(req.params.id, "user id");
+  const range = dayRange(req.query, 30);
+  const [person] = await peopleStats(me, range, { userId });
+  found(person, "That person");
+  const [tasks, dailyHours, reviews, activity] = await Promise.all([
+    sql`select t.id, p.key || '-' || t.number as key, t.title, t.status, t.priority, t.deadline, t.estimate_minutes, t.completed_at,
+               json_build_object('id', p.id, 'name', p.name) as project,
+               (t.status <> 'done' and t.deadline < now()) as overdue,
+               coalesce((select actual_minutes from v_task_time vt where vt.task_id = t.id), 0) as actual_minutes
+        from tasks t join projects p on p.id = t.project_id where t.assignee_id = ${userId}
+        order by (t.status = 'done'), t.deadline nulls last limit 200`,
+    sql`select day, hours_clocked from v_daily_hours where user_id = ${userId} and day between ${range.from} and ${range.to} order by day`,
+    sql`select rv.id, rv.decision, rv.rating, rv.comment, rv.created_at, p.key || '-' || t.number as task_key, t.title as task_title, t.id as task_id,
+               case when u.id is null then null else json_build_object('id', u.id, 'name', u.name) end as reviewer
+        from task_reviews rv join tasks t on t.id = rv.task_id join projects p on p.id = t.project_id left join users u on u.id = rv.reviewer_id
+        where rv.assignee_id = ${userId} order by rv.created_at desc limit 20`,
+    sql`select e.id, e.type, e.data, e.created_at, t.id as task_id, p.key || '-' || t.number as task_key, t.title as task_title
+        from task_events e join tasks t on t.id = e.task_id join projects p on p.id = t.project_id
+        where e.actor_id = ${userId} order by e.created_at desc limit 20`,
+  ]);
+  res.json({ range, person, tasks, daily_hours: dailyHours, reviews, activity });
+});
+
+module.exports = router;
diff --git a/Back/src/modules/people/stats.js b/Back/src/modules/people/stats.js
new file mode 100644
index 0000000..75450b5
--- /dev/null
+++ b/Back/src/modules/people/stats.js
@@ -0,0 +1,33 @@
+// Per-person performance numbers, shared by the People pages, the dashboard and reports.
+const sql = require("../../db");
+const { peopleFilter } = require("../../access");
+
+/** One row per visible person: delivery, quality, workload and hours in the range. */
+async function peopleStats(me, { from, to }, { includeInactive = true, userId = null } = {}) {
+  return sql`
+    select u.id, u.name, u.email, u.title, u.is_active,
+           case when d.id is null then null else json_build_object('id', d.id, 'name', d.name) end as department,
+           json_build_object('id', r.id, 'name', r.name) as role,
+           coalesce(s.tasks_done, 0) as tasks_done,
+           s.on_time_pct,
+           q.avg_rating,
+           coalesce(q.changes_requested, 0) as changes_requested,
+           (select count(*) from tasks t where t.assignee_id = u.id and t.status <> 'done') as open_tasks,
+           (select count(*) from tasks t where t.assignee_id = u.id and t.status <> 'done' and t.deadline < now()) as overdue_tasks,
+           (select count(*) from tasks t where t.assignee_id = u.id and t.status = 'in_review') as in_review,
+           coalesce((select sum(h.hours_clocked) from v_daily_hours h where h.user_id = u.id and h.day between ${from} and ${to}), 0) as hours_clocked,
+           coalesce((select round(sum(extract(epoch from coalesce(l.ended_at, now()) - l.started_at)) / 3600, 2) from task_time_logs l
+                     where l.user_id = u.id and (l.started_at at time zone 'Asia/Kolkata')::date between ${from} and ${to}), 0) as task_hours,
+           (select s2.clock_in from work_sessions s2 where s2.user_id = u.id and s2.clock_out is null) as clocked_in_since
+    from users u
+    join roles r on r.id = u.role_id
+    left join departments d on d.id = u.department_id
+    left join v_user_task_stats s on s.user_id = u.id
+    left join v_user_quality q on q.user_id = u.id
+    where ${peopleFilter(me)}
+      ${includeInactive ? sql`` : sql`and u.is_active`}
+      ${userId ? sql`and u.id = ${userId}` : sql``}
+    order by lower(u.name)`;
+}
+
+module.exports = { peopleStats };
diff --git a/Back/src/modules/projects/routes.js b/Back/src/modules/projects/routes.js
new file mode 100644
index 0000000..5e77373
--- /dev/null
+++ b/Back/src/modules/projects/routes.js
@@ -0,0 +1,182 @@
+// Projects and their custom task fields.
+const express = require("express");
+const sql = require("../../db");
+const v = require("../../lib/validate");
+const { HttpError, found, forbid } = require("../../lib/http");
+const { can } = require("../../middleware/auth");
+const { projectFilter, canManageProject } = require("../../access");
+
+const router = express.Router();
+const STATUSES = ["planned", "active", "on_hold", "completed"];
+const FIELD_TYPES = ["text", "number", "date", "select", "multi_select", "checkbox", "url"];
+
+/** Project columns with owner, department and task progress. */
+const projectColumns = sql`
+  p.id, p.key, p.name, p.description_md, p.status, p.start_date, p.deadline, p.completed_at, p.created_at, p.updated_at,
+  p.department_id, p.owner_id,
+  case when d.id is null then null else json_build_object('id', d.id, 'name', d.name) end as department,
+  case when o.id is null then null else json_build_object('id', o.id, 'name', o.name) end as owner,
+  (select count(*) from tasks t where t.project_id = p.id) as task_count,
+  (select count(*) from tasks t where t.project_id = p.id and t.status = 'done') as tasks_done,
+  (select count(*) from tasks t where t.project_id = p.id and t.status <> 'done' and t.deadline < now()) as tasks_overdue,
+  (select coalesce(jsonb_object_agg(s, c), '{}') from (select status as s, count(*) as c from tasks t where t.project_id = p.id group by status) x) as tasks_by_status`;
+
+/** Fields for one project, in display order. */
+async function fieldsFor(projectId) {
+  return sql`select id, key, label, type, options, required, position from project_fields where project_id = ${projectId} order by position, id`;
+}
+
+/** Loads a project if `me` can see it; 404 otherwise. */
+async function visibleProject(me, id) {
+  const [p] = await sql`select ${projectColumns} from projects p left join departments d on d.id = p.department_id
+                        left join users o on o.id = p.owner_id where p.id = ${id} and ${projectFilter(me)}`;
+  return found(p, "That project");
+}
+
+/** Adds progress % and overdue flag to a project row. */
+function withProgress(p) {
+  return {
+    ...p,
+    progress_pct: p.task_count ? Math.round((100 * p.tasks_done) / p.task_count) : 0,
+    overdue: p.status !== "completed" && p.deadline !== null && new Date(p.deadline) < Date.now(),
+  };
+}
+
+/** Requires projects.manage for this specific project. */
+function assertManage(me, project) {
+  if (!canManageProject(me, project)) forbid("You can't change this project.");
+}
+
+/** GET /projects — projects you can see (?status). */
+router.get("/", async (req, res) => {
+  const me = res.locals.me;
+  const status = req.query.status ? v.oneOf(req.query.status, STATUSES, "status") : null;
+  const rows = await sql`
+    select ${projectColumns} from projects p left join departments d on d.id = p.department_id left join users o on o.id = p.owner_id
+    where ${projectFilter(me)} ${status ? sql`and p.status = ${status}` : sql``}
+    order by case p.status when 'active' then 0 when 'planned' then 1 when 'on_hold' then 2 else 3 end, p.deadline nulls last, p.name`;
+  res.json({ projects: rows.map(withProgress) });
+});
+
+/** GET /projects/:id — one project with its custom fields and what you can do with it. */
+router.get("/:id", async (req, res) => {
+  const me = res.locals.me;
+  const project = withProgress(await visibleProject(me, v.id(req.params.id, "project id")));
+  res.json({ project: { ...project, fields: await fieldsFor(project.id), can_manage: canManageProject(me, project) } });
+});
+
+/** Validates project fields from a request body (all optional on update). */
+async function parseProject(b, me, partial) {
+  const out = {};
+  if (!partial || b.key !== undefined) {
+    out.key = v.text(b.key, "Project key", { min: 2, max: 10 }).toUpperCase();
+    if (!/^[A-Z][A-Z0-9]{1,9}$/.test(out.key)) throw new HttpError(400, "Project key must be 2 to 10 letters or digits, starting with a letter.");
+  }
+  if (!partial || b.name !== undefined) out.name = v.text(b.name, "Project name", { min: 2, max: 120 });
+  if (b.description_md !== undefined) out.description_md = v.optionalText(b.description_md, "Description", { max: 20000 });
+  if (b.status !== undefined) out.status = v.oneOf(b.status, STATUSES, "Status");
+  if (b.start_date !== undefined) out.start_date = v.day(b.start_date, "Start date");
+  if (b.deadline !== undefined) out.deadline = v.timestamp(b.deadline, "Deadline");
+  if (b.owner_id !== undefined) {
+    out.owner_id = v.nullableId(b.owner_id, "Owner");
+    if (out.owner_id) found((await sql`select 1 from users where id = ${out.owner_id} and is_active`)[0], "That owner");
+  }
+  if (b.department_id !== undefined) {
+    out.department_id = v.nullableId(b.department_id, "Department");
+    if (out.department_id) found((await sql`select 1 from departments where id = ${out.department_id}`)[0], "That department");
+  }
+  // Department-scoped managers can only run projects in their own department.
+  if (me.role.scope !== "all" && out.department_id !== undefined && out.department_id !== me.department_id) {
+    forbid("You can only put projects in your own department.");
+  }
+  if (out.status === "completed") out.completed_at = new Date().toISOString();
+  else if (out.status) out.completed_at = null;
+  return out;
+}
+
+/** POST /projects — creates a project. */
+router.post("/", async (req, res) => {
+  const me = res.locals.me;
+  if (!can(me, "projects.manage")) forbid();
+  const body = { department_id: me.role.scope === "all" ? null : me.department_id, owner_id: me.id, ...(req.body ?? {}) };
+  const row = await parseProject(body, me, false);
+  const [p] = await sql`insert into projects ${sql({ ...row, created_by: me.id })} returning id`;
+  res.status(201).json({ project: withProgress(await visibleProject(me, p.id)) });
+});
+
+/** PATCH /projects/:id — edits a project. */
+router.patch("/:id", async (req, res) => {
+  const me = res.locals.me;
+  const project = await visibleProject(me, v.id(req.params.id, "project id"));
+  assertManage(me, project);
+  const changes = await parseProject(req.body ?? {}, me, true);
+  if (!Object.keys(changes).length) throw new HttpError(400, "Nothing to change.");
+  await sql`update projects set ${sql(changes)} where id = ${project.id}`;
+  res.json({ project: withProgress(await visibleProject(me, project.id)) });
+});
+
+/** DELETE /projects/:id — deletes a project that has no tasks yet. */
+router.delete("/:id", async (req, res) => {
+  const me = res.locals.me;
+  const project = await visibleProject(me, v.id(req.params.id, "project id"));
+  assertManage(me, project);
+  if (project.task_count > 0) throw new HttpError(409, "This project has tasks. Mark it Completed instead, so its history is kept.");
+  await sql`delete from projects where id = ${project.id}`;
+  res.status(204).end();
+});
+
+/** Validates a custom field definition. */
+function parseField(b, partial) {
+  const out = {};
+  if (!partial || b.label !== undefined) out.label = v.text(b.label, "Field name", { max: 60 });
+  if (!partial) {
+    out.key = (typeof b.key === "string" && b.key ? b.key : out.label).toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "").slice(0, 40);
+    if (!/^[a-z][a-z0-9_]{0,39}$/.test(out.key)) throw new HttpError(400, "Field name must start with a letter.");
+    out.type = v.oneOf(b.type, FIELD_TYPES, "Field type");
+  }
+  if (b.options !== undefined) {
+    if (!Array.isArray(b.options)) throw new HttpError(400, "Options must be a list.");
+    out.options = [...new Set(b.options.map((o) => v.text(o, "Each option", { max: 60 })))];
+  }
+  if (b.required !== undefined) out.required = v.bool(b.required, "Required");
+  if (b.position !== undefined) out.position = v.int(b.position, "Position", { min: 0, max: 1000 });
+  return out;
+}
+
+/** POST /projects/:id/fields — adds a custom field. */
+router.post("/:id/fields", async (req, res) => {
+  const me = res.locals.me;
+  const project = await visibleProject(me, v.id(req.params.id, "project id"));
+  assertManage(me, project);
+  const field = parseField(req.body ?? {}, false);
+  if (["select", "multi_select"].includes(field.type) && !field.options?.length) throw new HttpError(400, "Add at least one option.");
+  await sql`insert into project_fields ${sql({ ...field, project_id: project.id })}`;
+  res.status(201).json({ fields: await fieldsFor(project.id) });
+});
+
+/** PATCH /projects/:id/fields/:fieldId — renames a field or changes its options. */
+router.patch("/:id/fields/:fieldId", async (req, res) => {
+  const me = res.locals.me;
+  const project = await visibleProject(me, v.id(req.params.id, "project id"));
+  assertManage(me, project);
+  const changes = parseField(req.body ?? {}, true);
+  if (!Object.keys(changes).length) throw new HttpError(400, "Nothing to change.");
+  const [row] = await sql`update project_fields set ${sql(changes)} where id = ${v.id(req.params.fieldId, "field id")} and project_id = ${project.id} returning id`;
+  found(row, "That field");
+  res.json({ fields: await fieldsFor(project.id) });
+});
+
+/** DELETE /projects/:id/fields/:fieldId — removes a field and its values from every task. */
+router.delete("/:id/fields/:fieldId", async (req, res) => {
+  const me = res.locals.me;
+  const project = await visibleProject(me, v.id(req.params.id, "project id"));
+  assertManage(me, project);
+  await sql.begin(async (tx) => {
+    const [field] = await tx`delete from project_fields where id = ${v.id(req.params.fieldId, "field id")} and project_id = ${project.id} returning key`;
+    found(field, "That field");
+    await tx`update tasks set properties = properties - ${field.key} where project_id = ${project.id}`;
+  });
+  res.json({ fields: await fieldsFor(project.id) });
+});
+
+module.exports = { router, fieldsFor, visibleProject, withProgress };
diff --git a/Back/src/modules/reports/routes.js b/Back/src/modules/reports/routes.js
new file mode 100644
index 0000000..5eb0951
--- /dev/null
+++ b/Back/src/modules/reports/routes.js
@@ -0,0 +1,83 @@
+// CSV reports, limited to what the person can see.
+const express = require("express");
+const sql = require("../../db");
+const { permit } = require("../../middleware/auth");
+const { taskFilter, peopleFilter, projectFilter, departmentFilter } = require("../../access");
+const { dayRange } = require("../../lib/dates");
+const { sendCsv } = require("../../lib/csv");
+const { peopleStats } = require("../people/stats");
+
+const router = express.Router();
+router.use(permit("reports.export"));
+
+/** Formats a timestamp for spreadsheets in India time. */
+const ist = (d) => (d ? new Date(d).toLocaleString("en-GB", { timeZone: "Asia/Kolkata", hour12: false }) : "");
+
+/** GET /reports/people.csv — performance per person for the range. */
+router.get("/people.csv", async (req, res) => {
+  const range = dayRange(req.query, 30);
+  const rows = await peopleStats(res.locals.me, range);
+  sendCsv(res, `people-${range.from}-to-${range.to}.csv`,
+    ["Name", "Email", "Title", "Department", "Role", "Active", "Tasks done", "On time %", "Avg rating", "Changes requested", "Open tasks", "Overdue", "Hours clocked", "Hours on tasks"],
+    rows.map((p) => [p.name, p.email, p.title, p.department?.name, p.role.name, p.is_active ? "Yes" : "No", p.tasks_done, p.on_time_pct, p.avg_rating, p.changes_requested, p.open_tasks, p.overdue_tasks, p.hours_clocked, p.task_hours]));
+});
+
+/** GET /reports/tasks.csv — every task you can see. */
+router.get("/tasks.csv", async (req, res) => {
+  const me = res.locals.me;
+  const rows = await sql`
+    select p.key || '-' || t.number as key, t.title, p.name as project, t.status, t.priority, a.name as assignee, d.name as department,
+           t.deadline, t.completed_at, t.estimate_minutes, t.labels,
+           coalesce((select actual_minutes from v_task_time vt where vt.task_id = t.id), 0) as actual_minutes,
+           (select rating from task_reviews rv where rv.task_id = t.id and rv.decision = 'approved' order by rv.created_at desc limit 1) as rating
+    from tasks t join projects p on p.id = t.project_id left join users a on a.id = t.assignee_id left join departments d on d.id = a.department_id
+    where ${taskFilter(me)} order by p.key, t.number`;
+  sendCsv(res, "tasks.csv",
+    ["Key", "Title", "Project", "Status", "Priority", "Assignee", "Department", "Deadline", "Completed", "Estimate (min)", "Actual (min)", "Rating", "Labels"],
+    rows.map((t) => [t.key, t.title, t.project, t.status, t.priority, t.assignee, t.department, ist(t.deadline), ist(t.completed_at), t.estimate_minutes, t.actual_minutes, t.rating, t.labels]));
+});
+
+/** GET /reports/projects.csv — project progress. */
+router.get("/projects.csv", async (req, res) => {
+  const rows = await sql`
+    select p.key, p.name, p.status, d.name as department, o.name as owner, p.deadline,
+           (select count(*) from tasks t where t.project_id = p.id) as total,
+           (select count(*) from tasks t where t.project_id = p.id and t.status = 'done') as done,
+           (select count(*) from tasks t where t.project_id = p.id and t.status <> 'done' and t.deadline < now()) as overdue
+    from projects p left join departments d on d.id = p.department_id left join users o on o.id = p.owner_id
+    where ${projectFilter(res.locals.me)} order by p.key`;
+  sendCsv(res, "projects.csv", ["Key", "Project", "Status", "Department", "Owner", "Deadline", "Tasks", "Done", "Progress %", "Overdue tasks"],
+    rows.map((p) => [p.key, p.name, p.status, p.department, p.owner, ist(p.deadline), p.total, p.done, p.total ? Math.round((100 * p.done) / p.total) : 0, p.overdue]));
+});
+
+/** GET /reports/departments.csv — department totals for the range. */
+router.get("/departments.csv", async (req, res) => {
+  const { from, to } = dayRange(req.query, 30);
+  const rows = await sql`
+    select d.name,
+           (select count(*) from users u where u.department_id = d.id and u.is_active) as people,
+           (select count(*) from tasks t join users u on u.id = t.assignee_id where u.department_id = d.id and t.status <> 'done') as open,
+           (select count(*) from tasks t join users u on u.id = t.assignee_id where u.department_id = d.id and t.status = 'done') as done,
+           (select count(*) from tasks t join users u on u.id = t.assignee_id where u.department_id = d.id and t.status <> 'done' and t.deadline < now()) as overdue,
+           coalesce((select sum(h.hours_clocked) from v_daily_hours h join users u on u.id = h.user_id where u.department_id = d.id and h.day between ${from} and ${to}), 0) as hours,
+           (select round(avg(rv.rating), 2) from task_reviews rv join users u on u.id = rv.assignee_id where u.department_id = d.id and rv.decision = 'approved') as rating
+    from departments d where ${departmentFilter(res.locals.me)} order by d.name`;
+  sendCsv(res, `departments-${from}-to-${to}.csv`, ["Department", "People", "Open tasks", "Done", "Overdue", "Hours clocked", "Avg rating"],
+    rows.map((d) => [d.name, d.people, d.open, d.done, d.overdue, d.hours, d.rating]));
+});
+
+/** GET /reports/time.csv — every work session in the range. */
+router.get("/time.csv", async (req, res) => {
+  const { from, to } = dayRange(req.query, 30);
+  const rows = await sql`
+    select u.name, d.name as department, s.clock_in, s.clock_out,
+           round(extract(epoch from coalesce(s.clock_out, now()) - s.clock_in) / 60) as minutes,
+           (select count(*) from time_corrections c where c.session_id = s.id) as corrections
+    from work_sessions s join users u on u.id = s.user_id left join departments d on d.id = u.department_id
+    where ${peopleFilter(res.locals.me)} and (s.clock_in at time zone 'Asia/Kolkata')::date between ${from} and ${to}
+    order by u.name, s.clock_in`;
+  sendCsv(res, `time-${from}-to-${to}.csv`, ["Person", "Department", "Clock in", "Clock out", "Minutes", "Corrected"],
+    rows.map((r) => [r.name, r.department, ist(r.clock_in), r.clock_out ? ist(r.clock_out) : "Still clocked in", r.minutes, r.corrections > 0 ? "Yes" : "No"]));
+});
+
+module.exports = router;
diff --git a/Back/src/modules/reviews/routes.js b/Back/src/modules/reviews/routes.js
new file mode 100644
