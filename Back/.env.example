# Postgres connection string. In Supabase: Project > Connect > "Session pooler" (works on IPv4).
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Set to false only for a local database without TLS.
DATABASE_SSL=true
# At least 32 random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-bytes
PORT=3000
FRONTEND_URL=http://localhost:5173
