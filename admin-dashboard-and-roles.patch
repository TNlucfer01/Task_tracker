diff --git a/Back/middleware/requireRole.js b/Back/middleware/requireRole.js
new file mode 100644
index 0000000..0c4bf74
--- /dev/null
+++ b/Back/middleware/requireRole.js
@@ -0,0 +1,18 @@
+// Use after requireAuth. Example: router.use(requireRole("admin"))
+function requireRole(...allowedRoles) {
+  return function checkRole(req, res, next) {
+    const role = res.locals.authUser?.role;
+
+    if (!role) {
+      return res.status(401).json({ error: "Authentication required." });
+    }
+
+    if (!allowedRoles.includes(role)) {
+      return res.status(403).json({ error: "You do not have access to this resource." });
+    }
+
+    return next();
+  };
+}
+
+module.exports = requireRole;
diff --git a/Back/routes/admin/dashboard.js b/Back/routes/admin/dashboard.js
